<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card mt-5 text-center">
            <div class="card-body p-5" id="verifyContainer">
                
                <!-- Loading State -->
                <div id="verifyLoading" class="d-none">
                    <div class="spinner-border text-primary mb-3" style="width: 3rem; height: 3rem;" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <h4>Verifying Email...</h4>
                    <p class="text-muted">Please wait while we verify your account.</p>
                </div>
                
                <!-- Success State -->
                <div id="verifySuccess" class="d-none">
                    <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" fill="green" class="bi bi-check-circle mb-3" viewBox="0 0 16 16">
                      <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z"/>
                      <path d="M10.97 4.97a.235.235 0 0 0-.02.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-1.071-1.05z"/>
                    </svg>
                    <h4>Verification Successful!</h4>
                    <p class="text-muted" id="successMsg">Your email has been verified successfully.</p>
                    <a href="/login" class="btn btn-primary mt-3 px-4">Continue to Login</a>
                </div>
                
                <!-- Error State -->
                <div id="verifyError" class="d-none">
                    <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" fill="red" class="bi bi-x-circle mb-3" viewBox="0 0 16 16">
                      <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z"/>
                      <path d="M4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708z"/>
                    </svg>
                    <h4 id="errorTitle">Verification Failed</h4>
                    <p class="text-muted" id="errorMsg">The verification token is invalid or has expired.</p>
                    <div class="d-grid gap-2 col-8 mx-auto mt-3">
                        <button class="btn btn-primary" id="btnTryManual">Enter Token Manually</button>
                        <a href="/login" class="btn btn-outline-primary">Back to Login</a>
                    </div>
                </div>

                <!-- Manual Entry State -->
                <div id="verifyManual" class="d-none">
                    <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" fill="var(--primary)" class="bi bi-envelope-check mb-3" viewBox="0 0 16 16">
                        <path d="M2 2a2 2 0 0 0-2 2v8.01A2 2 0 0 0 2 14h5.5a.5.5 0 0 0 0-1H2a1 1 0 0 1-.966-.741l5.64-3.471L8 9.583l7-4.2V8.5a.5.5 0 0 0 1 0V4a2 2 0 0 0-2-2H2Zm3.708 6.208L1 11.105V5.383l4.708 2.825ZM1 4.217V4a1 1 0 0 1 1-1h12a1 1 0 0 1 1-1v.217l-7 4.2-7-4.2Z"/>
                        <path d="M16 12.5a3.5 3.5 0 1 1-7 0 3.5 3.5 0 0 1 7 0Zm-1.993-1.679a.5.5 0 0 0-.686.172l-1.17 1.95-.547-.547a.5.5 0 0 0-.708.708l.774.773a.75.75 0 0 0 1.174-.144l1.335-2.226a.5.5 0 0 0-.172-.686Z"/>
                    </svg>
                    <h4>Verify Your Account</h4>
                    <p class="text-muted mb-4">Please enter the verification token sent to your email address.</p>
                    
                    <form id="manualVerifyForm">
                        <div class="mb-3">
                            <input type="text" class="form-control form-control-lg text-center" id="manualToken" placeholder="Enter Token" required>
                        </div>
                        <button type="submit" class="btn btn-primary w-100 py-2" id="manualBtn">
                            <span class="spinner-border spinner-border-sm d-none me-2" id="manualSpinner" role="status" aria-hidden="true"></span>
                            Verify Email
                        </button>
                    </form>
                    <div class="mt-4">
                        <p class="small text-muted mb-0">Didn't receive a token? <a href="/login" class="text-decoration-none">Back to Login</a></p>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', async () => {
    const urlParams = new URLSearchParams(window.location.search);
    const token = urlParams.get('token');
    
    const loadingDiv = document.getElementById('verifyLoading');
    const successDiv = document.getElementById('verifySuccess');
    const errorDiv = document.getElementById('verifyError');
    const manualDiv = document.getElementById('verifyManual');
    
    const errorMsg = document.getElementById('errorMsg');
    const successMsg = document.getElementById('successMsg');
    const manualForm = document.getElementById('manualVerifyForm');
    
    // Try Manual button
    document.getElementById('btnTryManual').addEventListener('click', () => {
        errorDiv.classList.add('d-none');
        manualDiv.classList.remove('d-none');
    });

    if (token) {
        performVerification(token);
    } else {
        loadingDiv.classList.add('d-none');
        manualDiv.classList.remove('d-none');
    }

    manualForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const inputToken = document.getElementById('manualToken').value;
        performVerification(inputToken, true);
    });
    
    async function performVerification(tokenToVerify, isManual = false) {
        const btn = document.getElementById('manualBtn');
        
        // Hide all states first
        loadingDiv.classList.add('d-none');
        successDiv.classList.add('d-none');
        errorDiv.classList.add('d-none');
        manualDiv.classList.add('d-none');
        
        if (isManual) {
            manualDiv.classList.remove('d-none');
            setBtnLoading(btn, true);
        } else {
            loadingDiv.classList.remove('d-none');
        }
        
        try {
            const res = await fetch(`/api/auth/verify-email?token=${encodeURIComponent(tokenToVerify)}`);
            const data = await res.json();
            
            if (res.ok) {
                loadingDiv.classList.add('d-none');
                manualDiv.classList.add('d-none');
                successMsg.textContent = data.message || 'Your email has been verified successfully.';
                successDiv.classList.remove('d-none');
                showToast('Email verified successfully!');
            } else {
                loadingDiv.classList.add('d-none');
                manualDiv.classList.add('d-none');
                errorMsg.textContent = data.error || data.message || 'The verification token is invalid or has expired.';
                errorDiv.classList.remove('d-none');
            }
        } catch (err) {
            handleFetchError(err);
            loadingDiv.classList.add('d-none');
            manualDiv.classList.add('d-none');
            errorMsg.textContent = 'A network error occurred while verifying your email.';
            errorDiv.classList.remove('d-none');
        } finally {
            if (isManual) {
                setBtnLoading(btn, false);
            }
        }
    }
});
</script>
