<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card mt-5">
            <div class="card-header text-center py-3">
                <h4 class="mb-0" id="formTitle">Reset Password</h4>
            </div>
            
            <!-- Success Message (Shared) -->
            <div id="successState" class="card-body p-4 text-center d-none">
                <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="green" class="bi bi-check-circle mb-3" viewBox="0 0 16 16">
                    <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z"/>
                    <path d="M10.97 4.97a.235.235 0 0 0-.02.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-1.071-1.05z"/>
                </svg>
                <h5 id="successHeading">Request Sent</h5>
                <p class="text-muted" id="successText">If an account exists with that email, a password reset link has been sent.</p>
                <a href="/login" class="btn btn-outline-primary mt-3">Back to Login</a>
            </div>

            <div id="formContainer" class="card-body p-4">
                <div id="error-message" class="alert alert-danger d-none" role="alert"></div>
                <div id="info-message" class="alert alert-info d-none" role="alert"></div>
                
                <!-- State 1: Request Reset Link -->
                <form id="requestForm" class="d-none">
                    <p class="text-muted mb-4">Enter your registered university email address and we'll send you a reset token.</p>
                    <div class="mb-4">
                        <label for="email" class="form-label">University Email</label>
                        <input type="email" class="form-control" id="email" required placeholder="name@my.westminster.ac.uk">
                    </div>
                    <button type="submit" class="btn btn-primary w-100 py-2" id="requestBtn">
                        <span class="spinner-border spinner-border-sm d-none me-2" id="requestSpinner" role="status" aria-hidden="true"></span>
                        Send Reset Token
                    </button>
                    <div class="text-center mt-3">
                        <a href="/login" class="text-decoration-none" style="color: var(--primary);">Back to Login</a>
                    </div>
                </form>

                <!-- State 2: Set New Password -->
                <form id="resetForm" class="d-none">
                    <p class="text-muted mb-4">Enter the token you received and your new password below.</p>
                    <div class="mb-3" id="tokenFieldGroup">
                        <label for="token" class="form-label">Reset Token</label>
                        <input type="text" class="form-control" id="token" required placeholder="Paste your token here">
                    </div>
                    <div class="mb-3">
                        <label for="newPassword" class="form-label">New Password</label>
                        <input type="password" class="form-control" id="newPassword" required minlength="8">
                        <div class="form-text">At least 8 characters, one uppercase, one number.</div>
                    </div>
                    <div class="mb-4">
                        <label for="confirmPassword" class="form-label">Confirm New Password</label>
                        <input type="password" class="form-control" id="confirmPassword" required minlength="8">
                    </div>
                    <button type="submit" class="btn btn-accent w-100 py-2" id="resetBtn">
                        <span class="spinner-border spinner-border-sm d-none me-2" id="resetSpinner" role="status" aria-hidden="true"></span>
                        Reset Password
                    </button>
                    <div class="text-center mt-3">
                        <button type="button" class="btn btn-link text-decoration-none p-0" id="backToRequest" style="color: var(--primary); font-size: 0.9rem;">Didn't get a token? Request again</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
    const urlParams = new URLSearchParams(window.location.search);
    const urlToken = urlParams.get('token');
    
    const requestForm = document.getElementById('requestForm');
    const resetForm = document.getElementById('resetForm');
    const formTitle = document.getElementById('formTitle');
    const errorDiv = document.getElementById('error-message');
    const infoDiv = document.getElementById('info-message');
    const tokenInput = document.getElementById('token');
    
    // Determine which state to show
    if (urlToken) {
        showResetState(urlToken);
    } else {
        showRequestState();
    }

    function showRequestState() {
        formTitle.textContent = 'Reset Password';
        requestForm.classList.remove('d-none');
        resetForm.classList.add('d-none');
        infoDiv.classList.add('d-none');
        errorDiv.classList.add('d-none');
    }

    function showResetState(token = '') {
        formTitle.textContent = 'Create New Password';
        requestForm.classList.add('d-none');
        resetForm.classList.remove('d-none');
        if (token) {
            tokenInput.value = token;
            // Optionally hide token field if it came from URL to keep it clean
            // document.getElementById('tokenFieldGroup').classList.add('d-none');
        }
    }

    document.getElementById('backToRequest').addEventListener('click', showRequestState);
    
    // Handle State 1 Submit
    requestForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const email = document.getElementById('email').value;
        const btn = document.getElementById('requestBtn');
        const spinner = document.getElementById('requestSpinner');
        
        btn.disabled = true;
        spinner.classList.remove('d-none');
        errorDiv.classList.add('d-none');
        infoDiv.classList.add('d-none');
        
        try {
            const csrfToken = await getCsrfToken();
            if (!csrfToken) throw new Error("Failed to secure the session. Please refresh.");
            
            const res = await fetch('/api/auth/forgot-password', {
                method: 'POST',
                credentials: 'include',
                headers: {
                    'Content-Type': 'application/json',
                    'X-CSRF-TOKEN': csrfToken
                },
                body: JSON.stringify({ email })
            });
            
            const data = await res.json();
            
            if (res.ok) {
                showResetState();
                infoDiv.textContent = 'Reset token sent! Please check your email and enter it below.';
                infoDiv.classList.remove('d-none');
            } else {
                errorDiv.textContent = data.error || data.message || 'Failed to send reset token.';
                errorDiv.classList.remove('d-none');
            }
        } catch (err) {
            errorDiv.textContent = 'A network error occurred.';
            errorDiv.classList.remove('d-none');
        } finally {
            btn.disabled = false;
            spinner.classList.add('d-none');
        }
    });
    
    // Handle State 2 Submit
    resetForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const token = tokenInput.value;
        const newPassword = document.getElementById('newPassword').value;
        const confirmPassword = document.getElementById('confirmPassword').value;
        const btn = document.getElementById('resetBtn');
        const spinner = document.getElementById('resetSpinner');
        
        if (!token) {
            errorDiv.textContent = 'Reset token is required.';
            errorDiv.classList.remove('d-none');
            return;
        }

        if (newPassword !== confirmPassword) {
            errorDiv.textContent = 'Passwords do not match.';
            errorDiv.classList.remove('d-none');
            return;
        }
        
        btn.disabled = true;
        spinner.classList.remove('d-none');
        errorDiv.classList.add('d-none');
        infoDiv.classList.add('d-none');
        
        try {
            const csrfToken = await getCsrfToken();
            if (!csrfToken) throw new Error("Failed to secure the session. Please refresh.");
            
            const res = await fetch('/api/auth/reset-password', {
                method: 'POST',
                credentials: 'include',
                headers: {
                    'Content-Type': 'application/json',
                    'X-CSRF-TOKEN': csrfToken
                },
                body: JSON.stringify({ token, newPassword })
            });
            
            const data = await res.json();
            
            if (res.ok) {
                document.getElementById('formContainer').classList.add('d-none');
                document.getElementById('successHeading').textContent = 'Password Reset!';
                document.getElementById('successText').textContent = 'Your password has been successfully reset. You can now log in with your new password.';
                document.getElementById('successState').classList.remove('d-none');
            } else {
                errorDiv.textContent = data.error || data.message || 'Failed to reset password. The token may be invalid or expired.';
                errorDiv.classList.remove('d-none');
            }
        } catch (err) {
            errorDiv.textContent = 'A network error occurred.';
            errorDiv.classList.remove('d-none');
        } finally {
            btn.disabled = false;
            spinner.classList.add('d-none');
        }
    });
});
</script>
