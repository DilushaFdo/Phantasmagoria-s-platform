<div class="row align-items-center mt-5">
    <div class="col-md-6 text-center text-md-start">
        <h1 class="display-4 fw-bold" style="color: var(--primary);">Welcome to Alumni Influencers</h1>
        <p class="lead mt-3">Discover the career trajectories, certifications, and impact of our most successful university graduates.</p>
        
        <div class="mt-4">
            <% if (locals.user) { %>
                <a href="<%= user.role === 'sponsor' ? '/sponsor-dashboard' : '/dashboard' %>" class="btn btn-primary btn-lg px-5">Go to My Dashboard</a>
            <% } else { %>
                <a href="/login" class="btn btn-primary btn-lg px-4 me-2">Login</a>
                <a href="/register" class="btn btn-outline-primary btn-lg px-4" style="border-color: var(--accent); color: var(--accent);">Join Network</a>
            <% } %>
        </div>
    </div>
    <div class="col-md-6 mt-5 mt-md-0 d-flex justify-content-center">
        <!-- We can add a nice hero image or graphic here later -->
        <div style="width: 300px; height: 300px; background-color: var(--primary); border-radius: 50%; opacity: 0.1; display: flex; align-items: center; justify-content: center;">
            <svg xmlns="http://www.w3.org/2000/svg" width="100" height="100" fill="var(--accent)" class="bi bi-mortarboard" viewBox="0 0 16 16">
              <path d="M8.156 1.812a8 8 0 0 0-5.14 2.164l-.946.545-.008.005A3.003 3.003 0 0 0 1 7.027v3.298a.5.5 0 0 0 .5.5h1a.5.5 0 0 0 .5-.5V7.482l1.625.938A7.95 7.95 0 0 0 8 10c1.785 0 3.433-.585 4.767-1.579L14.5 7.412V10.5a.5.5 0 0 0 .5.5h1a.5.5 0 0 0 .5-.5V7.027a3.003 3.003 0 0 0-1.062-2.501l-.008-.005-.946-.545a8 8 0 0 0-5.14-2.164L8.156 1.812zM8 3.033a6.99 6.99 0 0 1 4.298 1.488l-4.142 2.39L4.015 4.52a6.99 6.99 0 0 1 3.985-1.487zm-5.46 2.656a1.996 1.996 0 0 1 .59-1.226l1.371.79-1.961 1.131zM13.46 5.689l-1.961-1.13 1.371-.79a1.996 1.996 0 0 1 .59 1.225v.7z"/>
            </svg>
        </div>
    </div>
</div>

<div class="row mt-5 pt-5">
    <div class="col-md-4 text-center mb-4">
        <h3 style="color: var(--accent);">Connect</h3>
        <p>Network with alumni who have successfully transitioned into your target industry.</p>
    </div>
    <div class="col-md-4 text-center mb-4">
        <h3 style="color: var(--accent);">Learn</h3>
        <p>Discover which professional certifications and courses actually lead to top-tier roles.</p>
    </div>
    <div class="col-md-4 text-center mb-4">
        <h3 style="color: var(--accent);">Grow</h3>
        <p>Bid for 1-on-1 mentorship sessions with our featured "Alumni of the Day".</p>
    </div>
</div>
