<nav class="navbar navbar-expand-lg navbar-dark" style="background-color: var(--primary);">
    <div class="container">
        <a class="navbar-brand fw-bold" href="<%= locals.user ? '/dashboard' : '/' %>">Alumni Influencers</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                <% if (!locals.user) { %>
                    <li class="nav-item">
                        <a class="nav-link <%= (locals.path === '/') ? 'active fw-bold' : '' %>" href="/">Home</a>
                    </li>
                <% } %>
                <li class="nav-item">
                    <a class="nav-link <%= (locals.path === '/alumni/today') ? 'active fw-bold' : '' %>" href="/alumni/today">Alumni of the Day</a>
                </li>
            </ul>
            <ul class="navbar-nav">
                <!-- We check if a user object exists in locals to determine auth state -->
                <% if (locals.user) { %>
                    <li class="nav-item">
                        <a class="nav-link <%= (locals.path === '/profile') ? 'active fw-bold' : '' %>" href="/profile">Profile</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link <%= (locals.path === '/bidding') ? 'active fw-bold' : '' %>" href="/bidding">Bidding</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link <%= (locals.path && locals.path.startsWith('/dashboard')) ? 'active fw-bold' : '' %>" href="/dashboard">Dashboard</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link <%= (locals.path === '/developer') ? 'active fw-bold' : '' %>" href="/developer">Developer</a>
                    </li>
                    <% if (!locals.user.is_verified) { %>
                        <li class="nav-item">
                            <a class="btn btn-warning btn-sm ms-lg-2 mt-2 mt-lg-1 fw-bold" href="/verify-email" style="color: var(--primary);">Verify Account</a>
                        </li>
                    <% } %>
                    <li class="nav-item">
                        <a class="nav-link" href="/logout" onclick="return confirm('Are you sure you want to sign out?')">Logout</a>
                    </li>
                <% } else { %>
                    <li class="nav-item">
                        <a class="nav-link <%= (locals.path === '/login') ? 'active fw-bold' : '' %>" href="/login">Login</a>
                    </li>
                    <li class="nav-item">
                        <a class="btn btn-outline-light ms-2" style="border-color: var(--accent); color: var(--accent);" href="/register">Register</a>
                    </li>
                <% } %>
            </ul>
        </div>
    </div>
</nav>
