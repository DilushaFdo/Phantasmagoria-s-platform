<style>
    /* Sidebar styles are now managed in main.css via .dashboard-sidebar */
    #dashboardSidebar .nav-link.active {
        background-color: var(--accent) !important;
        color: white !important;
        font-weight: 600;
    }
    #dashboardSidebar .nav-link:hover:not(.active) {
        background-color: rgba(255, 255, 255, 0.1);
    }
    .cursor-not-allowed {
        cursor: not-allowed !important;
    }
    @media (max-width: 576px) {
        .sidebar-sticky {
            height: auto;
            position: relative;
        }
    }
</style>
