<div class="row mb-4 align-items-center">
    <div class="col">
        <h2 class="mb-0" style="color: var(--primary);">Edit Profile</h2>
        <p class="text-muted">Update your credentials and employment history</p>
    </div>
    <div class="col-auto">
        <a href="/profile" class="btn btn-outline-primary">Back to Profile</a>
    </div>
</div>

<div id="editSkeleton" class="card p-5 text-center placeholder-glow">
    <div class="spinner-border text-primary mb-3 mx-auto" role="status"></div>
    <p class="text-muted">Loading profile data...</p>
</div>

<div id="editContent" class="d-none">
    <div class="accordion" id="profileAccordion">
        
        <!-- 1. Basic Info -->
        <div class="accordion-item border-0 shadow-sm mb-3 rounded">
            <h2 class="accordion-header" id="headingBasic">
                <button class="accordion-button fw-bold rounded" type="button" data-bs-toggle="collapse" data-bs-target="#collapseBasic" aria-expanded="true" aria-controls="collapseBasic" style="color: var(--primary);">
                    1. Basic Information
                </button>
            </h2>
            <div id="collapseBasic" class="accordion-collapse collapse show" aria-labelledby="headingBasic" data-bs-parent="#profileAccordion">
                <div class="accordion-body p-4">
                    <form id="formBasicInfo">
                        <div class="mb-3">
                            <label for="biography" class="form-label">Biography</label>
                            <textarea class="form-control" id="biography" rows="4" maxlength="500"></textarea>
                            <div class="form-text">Max 500 characters.</div>
                        </div>
                        <div class="mb-4">
                            <label for="linkedin_url" class="form-label">LinkedIn URL</label>
                            <input type="text" class="form-control" id="linkedin_url" placeholder="https://linkedin.com/in/yourprofile">
                        </div>
                        <button type="submit" class="btn btn-primary" id="btnBasic">
                            <span class="spinner-border spinner-border-sm d-none me-1" id="spinBasic"></span> Save Changes
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <!-- 2. Profile Image -->
        <div class="accordion-item border-0 shadow-sm mb-3 rounded">
            <h2 class="accordion-header" id="headingImage">
                <button class="accordion-button collapsed fw-bold rounded" type="button" data-bs-toggle="collapse" data-bs-target="#collapseImage" aria-expanded="false" aria-controls="collapseImage" style="color: var(--primary);">
                    2. Profile Image
                </button>
            </h2>
            <div id="collapseImage" class="accordion-collapse collapse" aria-labelledby="headingImage" data-bs-parent="#profileAccordion">
                <div class="accordion-body p-4">
                    <div class="row align-items-center">
                        <div class="col-auto">
                            <img id="currentImagePreview" src="https://ui-avatars.com/api/?name=User&background=1e3a5f&color=fff" alt="Preview" class="rounded-circle border" style="width: 100px; height: 100px; object-fit: cover;">
                        </div>
                        <div class="col">
                            <form id="formImage">
                                <div class="mb-3">
                                    <label for="profile_image_path" class="form-label">Image URL</label>
                                    <input type="url" class="form-control" id="profile_image_path" placeholder="https://example.com/my-photo.jpg" required>
                                    <div class="form-text">Provide a direct link to an image (e.g. from an image hosting service).</div>
                                </div>
                                <button type="submit" class="btn btn-primary" id="btnImage">
                                    <span class="spinner-border spinner-border-sm d-none me-1" id="spinImage"></span> Save Changes
                                </button>
                                <button type="button" class="btn btn-outline-danger ms-2" id="btnDeleteImage">Remove Image</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Sections 3-6: Credentials (Degree, Cert, Licence, Course) will be generated by JS to keep HTML clean -->
        <div id="credentialSectionsContainer"></div>

        <!-- 7. Employment History -->
        <div class="accordion-item border-0 shadow-sm mb-3 rounded">
            <h2 class="accordion-header" id="headingEmployment">
                <button class="accordion-button collapsed fw-bold rounded" type="button" data-bs-toggle="collapse" data-bs-target="#collapseEmployment" aria-expanded="false" aria-controls="collapseEmployment" style="color: var(--primary);">
                    7. Employment History
                </button>
            </h2>
            <div id="collapseEmployment" class="accordion-collapse collapse" aria-labelledby="headingEmployment" data-bs-parent="#profileAccordion">
                <div class="accordion-body p-4">
                    <div id="list-employment"></div>
                    <hr class="my-4">
                    <h6 class="mb-3 fw-bold">Add Employment</h6>
                    <form id="formEmployment">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="emp_title" class="form-label">Job Title</label>
                                <input type="text" class="form-control" id="emp_title" required>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="emp_company" class="form-label">Company</label>
                                <input type="text" class="form-control" id="emp_company" required>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="emp_start" class="form-label">Start Date</label>
                                <input type="date" class="form-control" id="emp_start" required>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="emp_end" class="form-label">End Date</label>
                                <input type="date" class="form-control" id="emp_end">
                                <div class="form-check mt-2">
                                    <input class="form-check-input" type="checkbox" id="emp_current">
                                    <label class="form-check-label text-muted small" for="emp_current">I currently work here</label>
                                </div>
                            </div>
                        </div>
                        <button type="submit" class="btn btn-accent" id="btnEmployment">
                            <span class="spinner-border spinner-border-sm d-none me-1" id="spinEmployment"></span> Add Employment
                        </button>
                    </form>
                </div>
            </div>
        </div>

    </div>
</div>

<!-- Reusable Edit Modal for Credentials -->
<div class="modal fade" id="editModal" tabindex="-1" aria-labelledby="editModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content border-0 shadow">
      <div class="modal-header" style="background-color: var(--primary); color: white;">
        <h5 class="modal-title" id="editModalLabel">Edit Item</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <form id="modalForm">
            <input type="hidden" id="modalEndpoint">
            <input type="hidden" id="modalId">
            <input type="hidden" id="modalType">
            
            <div id="modalCredFields" class="d-none">
                <div class="mb-3">
                    <label for="modalTitle" class="form-label">Title</label>
                    <input type="text" class="form-control" id="modalTitle">
                </div>
                <div class="mb-3">
                    <label for="modalUrl" class="form-label">Credential URL</label>
                    <input type="url" class="form-control" id="modalUrl">
                </div>
                <div class="mb-3">
                    <label for="modalDate" class="form-label">Completion Date</label>
                    <input type="date" class="form-control" id="modalDate">
                </div>
            </div>

            <div id="modalEmpFields" class="d-none">
                <div class="mb-3">
                    <label for="modalEmpTitle" class="form-label">Job Title</label>
                    <input type="text" class="form-control" id="modalEmpTitle">
                </div>
                <div class="mb-3">
                    <label for="modalEmpCompany" class="form-label">Company</label>
                    <input type="text" class="form-control" id="modalEmpCompany">
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label for="modalEmpStart" class="form-label">Start Date</label>
                        <input type="date" class="form-control" id="modalEmpStart">
                    </div>
                    <div class="col-md-6 mb-3">
                        <label for="modalEmpEnd" class="form-label">End Date</label>
                        <input type="date" class="form-control" id="modalEmpEnd">
                        <div class="form-check mt-2">
                            <input class="form-check-input" type="checkbox" id="modalEmpCurrent">
                            <label class="form-check-label text-muted small" for="modalEmpCurrent">I currently work here</label>
                        </div>
                    </div>
                </div>
            </div>
        </form>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary" id="modalSaveBtn">
            <span class="spinner-border spinner-border-sm d-none me-1" id="modalSpinner"></span> Save Changes
        </button>
      </div>
    </div>
  </div>
</div>

<!-- Toast Container -->
<div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1100">
  <div id="liveToast" class="toast align-items-center text-white bg-success border-0" role="alert" aria-live="assertive" aria-atomic="true">
    <div class="d-flex">
      <div class="toast-body" id="toastMsg">Success!</div>
      <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
    </div>
  </div>
</div>

<script>
// Define credential sections for dynamic HTML generation
const credConfigs = [
    { num: 3, id: 'degree', label: 'Degrees', endpoint: '/api/profile/degree', dataKey: 'Degrees' },
    { num: 4, id: 'certification', label: 'Certifications', endpoint: '/api/profile/certification', dataKey: 'Certifications' },
    { num: 5, id: 'licence', label: 'Licences', endpoint: '/api/profile/licence', dataKey: 'Licences' },
    { num: 6, id: 'course', label: 'Professional Courses', endpoint: '/api/profile/course', dataKey: 'ProfessionalCourses' }
];

let globalCsrf = '';
let currentProfileData = null;
let editModalInstance = null;
let toastInstance = null;

document.addEventListener('DOMContentLoaded', async () => {
    // Generate Credential Accordion Sections
    const container = document.getElementById('credentialSectionsContainer');
    credConfigs.forEach(conf => {
        container.innerHTML += `
            <div class="accordion-item border-0 shadow-sm mb-3 rounded">
                <h2 class="accordion-header" id="heading_${conf.id}">
                    <button class="accordion-button collapsed fw-bold rounded" type="button" data-bs-toggle="collapse" data-bs-target="#collapse_${conf.id}" style="color: var(--primary);">
                        ${conf.num}. ${conf.label}
                    </button>
                </h2>
                <div id="collapse_${conf.id}" class="accordion-collapse collapse" data-bs-parent="#profileAccordion">
                    <div class="accordion-body p-4">
                        <div id="list-${conf.id}"></div>
                        <hr class="my-4">
                        <h6 class="mb-3 fw-bold">Add ${conf.label}</h6>
                        <form id="form-${conf.id}" onsubmit="handleAddCred(event, '${conf.endpoint}')">
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Title</label>
                                    <input type="text" class="form-control" id="title-${conf.id}" required>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Credential URL</label>
                                    <input type="url" class="form-control" id="url-${conf.id}">
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Completion Date</label>
                                    <input type="date" class="form-control" id="date-${conf.id}">
                                </div>
                            </div>
                            <button type="submit" class="btn btn-accent" id="btn-${conf.id}">
                                <span class="spinner-border spinner-border-sm d-none me-1" id="spin-${conf.id}"></span> Add
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        `;
    });

    // Initialize Bootstrap components
    editModalInstance = new bootstrap.Modal(document.getElementById('editModal'));
    // Initialize Bootstrap components
    editModalInstance = new bootstrap.Modal(document.getElementById('editModal'));

    // Employment checkbox logic
    document.getElementById('emp_current').addEventListener('change', function() {
        document.getElementById('emp_end').disabled = this.checked;
        if(this.checked) document.getElementById('emp_end').value = '';
    });

    try {
        const tokenRes = await fetch('/api/auth/csrf-token');
        const tokenData = await tokenRes.json();
        globalCsrf = tokenData.csrfToken;

        await loadProfileData();

        document.getElementById('editSkeleton').classList.add('d-none');
        document.getElementById('editContent').classList.remove('d-none');
    } catch (err) {
        handleFetchError(err);
        document.getElementById('editSkeleton').innerHTML = '<p class="text-danger">Failed to initialize. Please refresh.</p>';
    }

    // Attach Event Listeners for Static Forms
    document.getElementById('formBasicInfo').addEventListener('submit', handleBasicInfoSubmit);
    document.getElementById('formImage').addEventListener('submit', handleImageSubmit);
    document.getElementById('btnDeleteImage').addEventListener('click', handleDeleteImage);
    document.getElementById('formEmployment').addEventListener('submit', handleAddEmployment);
    document.getElementById('modalSaveBtn').addEventListener('click', handleModalSave);

    // Modal checkbox logic
    document.getElementById('modalEmpCurrent').addEventListener('change', function() {
        document.getElementById('modalEmpEnd').disabled = this.checked;
        if(this.checked) document.getElementById('modalEmpEnd').value = '';
    });
});

async function apiCall(url, method, bodyObj, btnId) {
    const btn = btnId ? document.getElementById(btnId) : null;
    if(btn) setBtnLoading(btn, true);
    
    try {
        const res = await fetch(url, {
            method: method,
            headers: {
                'Content-Type': 'application/json',
                'X-CSRF-TOKEN': globalCsrf
            },
            body: bodyObj ? JSON.stringify(bodyObj) : undefined
        });
        const data = await res.json();
        if(!res.ok) throw new Error(data.error || data.message || 'API Error');
        return data;
    } finally {
        if(btn) setBtnLoading(btn, false);
    }
}

async function loadProfileData() {
    try {
        const res = await fetch('/api/profile');
        let data = {};
        
        if (res.status === 404 || res.status === 204) {
            data = { Degrees: [], Certifications: [], Licences: [], ProfessionalCourses: [], EmploymentHistories: [] };
        } else {
            data = await res.json();
        }
        
        currentProfileData = data;
        
        // Populate Basic Info
        document.getElementById('biography').value = data.biography || '';
        document.getElementById('linkedin_url').value = data.linkedin_url || '';
        
        // Populate Image
        if (data.profile_image_path) {
            document.getElementById('profile_image_path').value = data.profile_image_path;
            document.getElementById('currentImagePreview').src = data.profile_image_path;
        } else {
            document.getElementById('profile_image_path').value = '';
            const name = data.User?.email?.split('@')[0] || 'Alumni';
            document.getElementById('currentImagePreview').src = `https://ui-avatars.com/api/?name=${name}&background=1e3a5f&color=fff`;
        }

        // Populate Credentials Lists
        credConfigs.forEach(conf => renderCredList(conf.id, data[conf.dataKey], conf.endpoint));
        
        // Populate Employment
        renderEmpList(data.EmploymentHistories);
    } catch (err) {
        handleFetchError(err);
    }
}

const formatDateShort = (date) => {
    if (!date) return 'Present';
    return new Date(date).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
};

// ── Basic Info & Image Handlers ──
async function handleBasicInfoSubmit(e) {
    e.preventDefault();
    const biography = document.getElementById('biography').value;
    const linkedin_url = document.getElementById('linkedin_url').value;
    try {
        await apiCall('/api/profile', 'PUT', { biography, linkedin_url }, 'btnBasic');
        showToast('Basic information saved!');
    } catch(err) { handleFetchError(err); }
}

async function handleImageSubmit(e) {
    e.preventDefault();
    const url = document.getElementById('profile_image_path').value;
    try {
        await apiCall('/api/profile/image', 'PUT', { profile_image_path: url }, 'btnImage');
        document.getElementById('currentImagePreview').src = url;
        showToast('Image updated!');
    } catch(err) { handleFetchError(err); }
}

async function handleDeleteImage() {
    if(!confirm("Remove profile image?")) return;
    try {
        await apiCall('/api/profile/image', 'DELETE', null, 'btnDeleteImage');
        document.getElementById('profile_image_path').value = '';
        const name = currentProfileData.User?.email?.split('@')[0] || 'Alumni';
        document.getElementById('currentImagePreview').src = `https://ui-avatars.com/api/?name=${name}&background=1e3a5f&color=fff`;
        showToast('Image removed!');
    } catch(err) { handleFetchError(err); }
}

// ── Credential Handlers ──
async function handleAddCred(e, endpoint) {
    e.preventDefault();
    const id = e.target.id.replace('form-', '');
    const title = document.getElementById(`title-${id}`).value;
    const url = document.getElementById(`url-${id}`).value || undefined;
    const completion_date = document.getElementById(`date-${id}`).value || undefined;
    
    try {
        await apiCall(endpoint, 'POST', { title, url, completion_date }, `btn-${id}`);
        e.target.reset();
        await loadProfileData();
        showToast('Successfully added!');
    } catch(err) { handleFetchError(err); }
}

function renderCredList(typeId, items, endpoint) {
    const listDiv = document.getElementById(`list-${typeId}`);
    if (!items || items.length === 0) {
        listDiv.innerHTML = '<div class="alert alert-light small text-muted border-0 py-2"><i class="bi bi-info-circle me-1"></i> No items added yet.</div>';
        return;
    }
    let html = '<ul class="list-group mb-3 border-0 shadow-sm">';
    items.forEach(item => {
        const itemJson = encodeURIComponent(JSON.stringify(item));
        html += `
            <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                <div>
                    <h6 class="mb-0 fw-bold">${item.title}</h6>
                    ${item.completion_date ? `<small class="text-muted">Completed: ${formatDateShort(item.completion_date)}</small>` : ''}
                </div>
                <div>
                    <button class="btn btn-sm btn-light me-1" onclick="openEditModal('cred', '${endpoint}', '${itemJson}')"><i class="bi bi-pencil"></i></button>
                    <button class="btn btn-sm btn-outline-danger" onclick="deleteItem('${endpoint}', ${item.id})"><i class="bi bi-trash"></i></button>
                </div>
            </li>
        `;
    });
    html += '</ul>';
    listDiv.innerHTML = html;
}

// ── Employment Handlers ──
async function handleAddEmployment(e) {
    e.preventDefault();
    const job_title = document.getElementById('emp_title').value;
    const company = document.getElementById('emp_company').value;
    const start_date = document.getElementById('emp_start').value;
    const end_date = document.getElementById('emp_current').checked ? null : (document.getElementById('emp_end').value || undefined);
    
    try {
        await apiCall('/api/profile/employment', 'POST', { job_title, company, start_date, end_date }, 'btnEmployment');
        e.target.reset();
        document.getElementById('emp_end').disabled = false;
        await loadProfileData();
        showToast('Employment added!');
    } catch(err) { handleFetchError(err); }
}

function renderEmpList(items) {
    const listDiv = document.getElementById('list-employment');
    if (!items || items.length === 0) {
        listDiv.innerHTML = '<div class="alert alert-light small text-muted border-0 py-2"><i class="bi bi-info-circle me-1"></i> No employment history added.</div>';
        return;
    }
    const sorted = [...items].sort((a,b) => new Date(b.start_date) - new Date(a.start_date));
    let html = '<ul class="list-group mb-3 border-0 shadow-sm">';
    sorted.forEach(item => {
        const itemJson = encodeURIComponent(JSON.stringify(item));
        const s = formatDateShort(item.start_date);
        const e = formatDateShort(item.end_date);
        html += `
            <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                <div>
                    <h6 class="mb-0 fw-bold">${item.job_title}</h6>
                    <small class="text-muted">${item.company} | ${s} to ${e}</small>
                </div>
                <div>
                    <button class="btn btn-sm btn-light me-1" onclick="openEditModal('emp', '/api/profile/employment', '${itemJson}')"><i class="bi bi-pencil"></i></button>
                    <button class="btn btn-sm btn-outline-danger" onclick="deleteItem('/api/profile/employment', ${item.id})"><i class="bi bi-trash"></i></button>
                </div>
            </li>
        `;
    });
    html += '</ul>';
    listDiv.innerHTML = html;
}

// ── Shared Modal & Delete Logic ──
function openEditModal(type, endpoint, itemJsonStr) {
    const item = JSON.parse(decodeURIComponent(itemJsonStr));
    document.getElementById('modalEndpoint').value = endpoint;
    document.getElementById('modalId').value = item.id;
    document.getElementById('modalType').value = type;
    
    if (type === 'cred') {
        document.getElementById('modalCredFields').classList.remove('d-none');
        document.getElementById('modalEmpFields').classList.add('d-none');
        
        document.getElementById('modalTitle').value = item.title;
        document.getElementById('modalUrl').value = item.url || '';
        document.getElementById('modalDate').value = item.completion_date ? new Date(item.completion_date).toISOString().split('T')[0] : '';
    } else {
        document.getElementById('modalCredFields').classList.add('d-none');
        document.getElementById('modalEmpFields').classList.remove('d-none');
        
        document.getElementById('modalEmpTitle').value = item.job_title;
        document.getElementById('modalEmpCompany').value = item.company;
        document.getElementById('modalEmpStart').value = item.start_date ? new Date(item.start_date).toISOString().split('T')[0] : '';
        
        const isCurrent = !item.end_date;
        document.getElementById('modalEmpCurrent').checked = isCurrent;
        document.getElementById('modalEmpEnd').disabled = isCurrent;
        document.getElementById('modalEmpEnd').value = item.end_date ? new Date(item.end_date).toISOString().split('T')[0] : '';
    }
    
    editModalInstance.show();
}

async function handleModalSave() {
    const endpoint = document.getElementById('modalEndpoint').value;
    const id = document.getElementById('modalId').value;
    const type = document.getElementById('modalType').value;
    
    let body = {};
    if (type === 'cred') {
        body.title = document.getElementById('modalTitle').value;
        const u = document.getElementById('modalUrl').value;
        body.url = u || null;
        const d = document.getElementById('modalDate').value;
        body.completion_date = d || null;
    } else {
        body.job_title = document.getElementById('modalEmpTitle').value;
        body.company = document.getElementById('modalEmpCompany').value;
        body.start_date = document.getElementById('modalEmpStart').value;
        const isCurrent = document.getElementById('modalEmpCurrent').checked;
        body.end_date = isCurrent ? null : (document.getElementById('modalEmpEnd').value || null);
    }
    
    try {
        await apiCall(`${endpoint}/${id}`, 'PUT', body, 'modalSaveBtn');
        editModalInstance.hide();
        await loadProfileData();
        showToast('Updated successfully!');
    } catch(err) { handleFetchError(err); }
}

async function deleteItem(endpoint, id) {
    if(!confirm("Are you sure you want to delete this item?")) return;
    try {
        await apiCall(`${endpoint}/${id}`, 'DELETE');
        await loadProfileData();
        showToast('Deleted successfully!');
    } catch(err) { handleFetchError(err); }
}
</script>
