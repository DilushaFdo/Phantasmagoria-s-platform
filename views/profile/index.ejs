<div class="row" id="profileSkeleton">
    <!-- Skeleton Loading State -->
    <div class="col-md-4 mb-4">
        <div class="card p-4 text-center placeholder-glow">
            <div class="placeholder rounded-circle mx-auto mb-3" style="width: 150px; height: 150px;"></div>
            <h4 class="placeholder col-6 mx-auto mb-2"></h4>
            <p class="placeholder col-4 mx-auto mb-4"></p>
            <div class="progress mb-3" style="height: 10px;">
                <div class="progress-bar bg-secondary w-0"></div>
            </div>
            <a href="#" class="btn btn-primary disabled placeholder col-12"></a>
        </div>
    </div>
    <div class="col-md-8">
        <div class="card placeholder-glow">
            <div class="card-header">
                <span class="placeholder col-3"></span>
            </div>
            <div class="card-body p-4">
                <p class="placeholder col-12"></p>
                <p class="placeholder col-10"></p>
                <p class="placeholder col-8"></p>
            </div>
        </div>
    </div>
</div>

<div class="row d-none" id="profileContent">
    <!-- Left Sidebar -->
    <div class="col-md-4 mb-4">
        <div class="card shadow-sm border-0">
            <div class="card-body text-center p-4">
                <img id="profileImage" src="" alt="Profile Image" class="rounded-circle mb-3 border border-4" style="width: 150px; height: 150px; object-fit: cover; border-color: var(--accent) !important;">
                
                <h4 id="profileName" class="fw-bold" style="color: var(--primary);"></h4>
                
                <div id="linkedinContainer" class="mb-2">
                    <!-- LinkedIn Link Injected Here -->
                </div>
                
                <div class="mb-4">
                    <small class="text-muted d-block mb-1">Email Address</small>
                    <p id="profileEmail" class="mb-0 text-dark small fw-medium"></p>
                </div>
                
                <div class="text-start mb-1 mt-4">
                    <small class="text-muted fw-bold">Profile Completion</small>
                    <small class="text-muted float-end" id="completionText">0%</small>
                </div>
                <div class="progress mb-4" style="height: 8px;">
                    <div id="completionBar" class="progress-bar" role="progressbar" style="width: 0%; background-color: var(--accent);" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div>
                </div>

                <a href="/profile/edit" class="btn btn-primary w-100">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-pencil-square me-2" viewBox="0 0 16 16">
                      <path d="M15.502 1.94a.5.5 0 0 1 0 .706L14.459 3.69l-2-2L13.502.646a.5.5 0 0 1 .707 0l1.293 1.293zm-1.75 2.456-2-2L4.939 9.21a.5.5 0 0 0-.121.196l-.805 2.414a.25.25 0 0 0 .316.316l2.414-.805a.5.5 0 0 0 .196-.12l6.813-6.814z"/>
                      <path fill-rule="evenodd" d="M1 13.5A1.5 1.5 0 0 0 2.5 15h11a1.5 1.5 0 0 0 1.5-1.5v-6a.5.5 0 0 0-1 0v6a.5.5 0 0 1-.5.5h-11a.5.5 0 0 1-.5-.5v-11a.5.5 0 0 1 .5-.5H9a.5.5 0 0 0 0-1H2.5A1.5 1.5 0 0 0 1 2.5v11z"/>
                    </svg>
                    Edit Profile
                </a>


            </div>
        </div>

        <!-- Bid Status Card -->
        <div class="card shadow-sm border-0 mt-4" id="bidStatusCard">
            <div class="card-header text-center" style="background-color: var(--primary); color: white;">
                <h6 class="mb-0 py-1">Featured Alumni Bid Status</h6>
            </div>
            <div class="card-body text-center p-4">
                <div id="bidStatusLoading">
                    <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                </div>
                
                <div id="bidStatusContent" class="d-none">
                    <!-- Dynamic Bid Content -->
                </div>

                <div class="mt-3 border-top pt-3 text-start">
                    <small class="text-muted d-block mb-1">Monthly Appearances Remaining:</small>
                    <h5 id="monthlySlots" class="fw-bold text-success mb-3">...</h5>
                </div>

                <a href="/bidding" class="btn btn-outline-primary w-100 btn-sm">Manage Bidding</a>
            </div>
        </div>
    </div>

    <!-- Right Main Content -->
    <div class="col-md-8">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white border-bottom pt-3 pb-0">
                <style>
                    #profileTabs .nav-link {
                        color: #555 !important;
                        border: none;
                        border-bottom: 2px solid transparent;
                        padding: 0.8rem 1.2rem;
                    }
                    #profileTabs .nav-link.active {
                        color: var(--primary) !important;
                        border-bottom: 2px solid var(--accent);
                        background: transparent;
                        font-weight: 600 !important;
                    }
                    #profileTabs .nav-link:hover {
                        color: var(--primary) !important;
                    }
                </style>
                <ul class="nav nav-tabs border-bottom-0" id="profileTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" id="bio-tab" data-bs-toggle="tab" data-bs-target="#bio" type="button" role="tab" style="color: var(--primary); font-weight: 500;">Biography</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="degree-tab" data-bs-toggle="tab" data-bs-target="#degree" type="button" role="tab" style="color: var(--primary); font-weight: 500;">Degrees</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="cert-tab" data-bs-toggle="tab" data-bs-target="#cert" type="button" role="tab" style="color: var(--primary); font-weight: 500;">Certifications</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="licence-tab" data-bs-toggle="tab" data-bs-target="#licence" type="button" role="tab" style="color: var(--primary); font-weight: 500;">Licences</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="course-tab" data-bs-toggle="tab" data-bs-target="#course" type="button" role="tab" style="color: var(--primary); font-weight: 500;">Courses</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="exp-tab" data-bs-toggle="tab" data-bs-target="#exp" type="button" role="tab" style="color: var(--primary); font-weight: 500;">Employment</button>
                    </li>
                </ul>
            </div>
            
            <div class="card-body p-4">
                <div class="tab-content" id="profileTabsContent">
                    
                    <!-- Bio Tab -->
                    <div class="tab-pane fade show active" id="bio" role="tabpanel">
                        <h5 class="mb-3" style="color: var(--primary);">About Me</h5>
                        <div id="bioContent" class="text-muted" style="white-space: pre-line;">
                            <!-- Injected -->
                        </div>
                    </div>

                    <!-- Degrees Tab -->
                    <div class="tab-pane fade" id="degree" role="tabpanel">
                        <h5 class="mb-4" style="color: var(--primary);">Degrees</h5>
                        <div id="degreeList">
                            <!-- Injected -->
                        </div>
                    </div>

                    <!-- Certifications Tab -->
                    <div class="tab-pane fade" id="cert" role="tabpanel">
                        <h5 class="mb-4" style="color: var(--primary);">Certifications</h5>
                        <div id="certList">
                            <!-- Injected -->
                        </div>
                    </div>

                    <!-- Licences Tab -->
                    <div class="tab-pane fade" id="licence" role="tabpanel">
                        <h5 class="mb-4" style="color: var(--primary);">Licences</h5>
                        <div id="licenceList">
                            <!-- Injected -->
                        </div>
                    </div>

                    <!-- Courses Tab -->
                    <div class="tab-pane fade" id="course" role="tabpanel">
                        <h5 class="mb-4" style="color: var(--primary);">Professional Courses</h5>
                        <div id="courseList">
                            <!-- Injected -->
                        </div>
                    </div>

                    <!-- Experience Tab -->
                    <div class="tab-pane fade" id="exp" role="tabpanel">
                        <h5 class="mb-4" style="color: var(--primary);">Employment History</h5>
                        <div id="employmentList" class="position-relative">
                            <!-- Injected -->
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

<script>
const loggedInUserId = <%- JSON.stringify(locals.user ? locals.user.id : null) %>;
const userRole = <%- JSON.stringify(locals.user ? locals.user.role : null) %>;
let currentProfileData = null;
let globalCsrf = '';

document.addEventListener('DOMContentLoaded', async () => {
    try {
        // Fetch CSRF token
        const csrfToken = await getCsrfToken();
        globalCsrf = csrfToken;

        // Detect if viewing a specific profile from URL
        const pathParts = window.location.pathname.split('/');
        const profileId = pathParts[pathParts.length - 1] === 'profile' ? null : pathParts[pathParts.length - 1];
        
        const fetchUrl = profileId ? `/api/profile/${profileId}` : '/api/profile';
        const res = await fetch(fetchUrl, { credentials: 'include' });
        
        if (res.status === 404 || res.status === 204) {
            if (!profileId) {
                window.location.href = '/profile/edit';
                return;
            } else {
                showError('Profile not found.');
                return;
            }
        }

        if (!res.ok) throw new Error('Failed to load profile');
        const json = await res.json();
        const data = json.data || json;
        currentProfileData = data;

        if (!data || !data.UserId) {
            showEmptyState();
            return;
        }
        
        renderProfile(data);

        // Attach event listener for the sponsorship offer button
        const sendOfferBtn = document.getElementById('sendOfferBtn');
        if (sendOfferBtn) {
            sendOfferBtn.addEventListener('click', handleSendOffer);
        }

    } catch (err) {
        console.error(err);
        showError('Something went wrong. Please refresh.');
    }
});

function showEmptyState() {
    document.getElementById('profileSkeleton').innerHTML = `
        <div class="text-center py-5 bg-white rounded shadow-sm">
            <i class="bi bi-person-circle" style="font-size:4rem; color:var(--primary)"></i>
            <h3 class="mt-3 fw-bold">Welcome! Let's set up your profile</h3>
            <p class="text-muted mx-auto" style="max-width: 500px;">
                Add your degrees, certifications, employment history and more to start bidding for Alumni of the Day.
            </p>
            <a href="/profile/edit" class="btn btn-primary btn-lg mt-2 px-5">
                Create My Profile
            </a>
        </div>
    `;
}

function showError(msg) {
    document.getElementById('profileSkeleton').innerHTML = `
        <div class="alert alert-danger w-100 text-center mt-5">
            <i class="bi bi-exclamation-triangle me-2"></i> ${msg}
        </div>
    `;
}

async function renderProfile(data) {
    // Show/Hide Edit buttons based on ownership
    const isOwner = loggedInUserId && (data.UserId === loggedInUserId);
    
    if (!isOwner) {
        // Hide Edit Profile button
        const editBtn = document.querySelector('a[href="/profile/edit"]');
        if (editBtn) editBtn.classList.add('d-none');
        
        // Hide Bid Status card entirely
        const bidCard = document.getElementById('bidStatusCard');
        if (bidCard) bidCard.classList.add('d-none');
    }

    // Setup Header Info
    const email = data.User && data.User.email ? data.User.email : 'Alumni';
    let name = email.split('@')[0];
    if (data.first_name && data.last_name) {
        name = `${data.first_name} ${data.last_name}`;
    } else if (data.first_name) {
        name = data.first_name;
    }
    document.getElementById('profileName').textContent = name;
    document.getElementById('profileEmail').textContent = email;
    
    // Image
    const img = document.getElementById('profileImage');
    if (data.profile_image_path) {
        img.src = data.profile_image_path;
    } else {
        img.src = `https://ui-avatars.com/api/?name=${name}&background=1e3a5f&color=fff&size=200`;
    }

    // LinkedIn
    const liContainer = document.getElementById('linkedinContainer');
    if (data.linkedin_url) {
        liContainer.innerHTML = `<a href="${data.linkedin_url}" target="_blank" class="text-decoration-none" style="color: #0a66c2;"><i class="bi bi-linkedin me-1"></i> LinkedIn Profile</a>`;
    }

    // Bio
    const bioContent = document.getElementById('bioContent');
    bioContent.textContent = data.biography || "No biography provided yet. Click 'Edit Profile' to add one.";

    // Render Lists Helper
    const formatDate = (date) => {
        if (!date) return 'Present';
        return new Date(date).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
    };

    const renderList = (containerId, items, titleKey, subtitleKey, dateKey, dateLabel, emptyMsg) => {
        const container = document.getElementById(containerId);
        const isOwner = loggedInUserId && (currentProfileData.UserId === loggedInUserId);

        if (!items || items.length === 0) {
            container.innerHTML = `<div class="text-center py-4 text-muted fst-italic"><i class="bi bi-inbox fs-2 d-block mb-2"></i> ${emptyMsg}</div>`;
            return;
        }
        
        let html = '<ul class="list-group list-group-flush">';
        items.forEach(item => {
            const dateStr = formatDate(item[dateKey]);
            const urlHtml = item.url || item.credential_url ? `<a href="${item.url || item.credential_url}" target="_blank" class="float-end btn btn-sm btn-outline-primary" style="font-size: 0.75rem;">View</a>` : '';
            
            // Sponsor button for sponsors viewing others' profiles
            let sponsorHtml = '';
            if (userRole === 'sponsor' && !isOwner && (containerId === 'certList' || containerId === 'licenceList')) {
                const type = containerId === 'certList' ? 'cert' : 'lic';
                sponsorHtml = `<button class="float-end btn btn-sm btn-accent ms-2 fw-bold" style="font-size: 0.75rem;" data-bs-toggle="modal" data-bs-target="#sponsorshipModal" onclick="preSelectSponsorItem('${type}', ${item.id})"><i class="bi bi-award me-1"></i> Sponsor</button>`;
            }

            html += `
                <li class="list-group-item px-0 py-3">
                    ${sponsorHtml}
                    ${urlHtml}
                    <h6 class="mb-1 fw-bold text-dark">${item[titleKey]}</h6>
                    <p class="mb-1 text-muted small">${subtitleKey && item[subtitleKey] ? item[subtitleKey] + ' &bull; ' : ''}${dateLabel}: ${dateStr}</p>
                </li>
            `;
        });
        html += '</ul>';
        container.innerHTML = html;
    };

    window.preSelectSponsorItem = (type, id) => {
        const select = document.getElementById('sponsorItemSelect');
        if (select) {
            select.value = `${type}_${id}`;
        }
    };

    renderList('degreeList', data.Degrees, 'title', null, 'completion_date', 'Completed', 'No degrees added.');
    renderList('courseList', data.ProfessionalCourses, 'title', null, 'completion_date', 'Completed', 'No courses added.');
    renderList('certList', data.Certifications, 'title', null, 'completion_date', 'Completed', 'No certifications added.');
    renderList('licenceList', data.Licences, 'title', null, 'completion_date', 'Completed', 'No licences added.');
    
    // Employment needs slightly different rendering (start_date to end_date)
    const empContainer = document.getElementById('employmentList');
    if (!data.EmploymentHistories || data.EmploymentHistories.length === 0) {
        empContainer.innerHTML = `<div class="text-center py-4 text-muted fst-italic"><i class="bi bi-briefcase fs-2 d-block mb-2"></i> No employment history added.</div>`;
    } else {
        const sortedEmp = [...data.EmploymentHistories].sort((a,b) => new Date(b.start_date) - new Date(a.start_date));
        let html = '<div class="timeline">';
        sortedEmp.forEach(job => {
            const startStr = formatDate(job.start_date);
            const endStr = formatDate(job.end_date);
            html += `
                <div class="mb-4 ps-3 border-start border-2 border-primary">
                    <h6 class="mb-0 fw-bold">${job.job_title}</h6>
                    <p class="mb-1 text-muted" style="color: var(--accent) !important;">${job.company}</p>
                    <small class="text-muted">${startStr} - ${endStr}</small>
                </div>
            `;
        });
        html += '</div>';
        empContainer.innerHTML = html;
    }

    // Calculate Completion % (Specific Weighted Request)
    let pct = 0;
    if (data.biography) pct += 20;
    if (data.Degrees && data.Degrees.length > 0) pct += 20;
    if (data.Certifications && data.Certifications.length > 0) pct += 15;
    if (data.Licences && data.Licences.length > 0) pct += 15;
    if (data.ProfessionalCourses && data.ProfessionalCourses.length > 0) pct += 15;
    if (data.linkedin_url) pct += 15;
    
    document.getElementById('completionBar').style.width = pct + '%';
    document.getElementById('completionText').textContent = pct + '%';
    
    // Hide Skeleton, Show Content
    document.getElementById('profileSkeleton').classList.add('d-none');
    document.getElementById('profileContent').classList.remove('d-none');
    
    // Fetch Bidding Data
    fetchBiddingStatus(data);

    // Setup Sponsorship Modal if user is a sponsor
    if (userRole === 'sponsor' && !isOwner) {
        setupSponsorshipModal(data);
    }
}

async function fetchBiddingStatus(profileData) {
    const loadingDiv = document.getElementById('bidStatusLoading');
    const contentDiv = document.getElementById('bidStatusContent');
    const slotsDiv = document.getElementById('monthlySlots');
    
    try {
        slotsDiv.textContent = profileData.remaining_monthly_slots || 0;
        const tomorrowRes = await fetch('/api/bids/tomorrow', { credentials: 'include' });
        const tomorrowJson = await tomorrowRes.json();
        const tData = tomorrowJson.data || tomorrowJson;
        
        if (tData.bid_placed) {
            const tmrwDate = new Date();
            tmrwDate.setDate(tmrwDate.getDate() + 1);
            const dateStr = tmrwDate.toISOString().split('T')[0];
            const statusRes = await fetch(`/api/bids/status?target_date=${dateStr}`, { credentials: 'include' });
            const statusJson = await statusRes.json();
            const sData = statusJson.data || statusJson;
            
            if (statusRes.ok) {
                const badgeColor = sData.status === 'winning' ? 'bg-success' : 'bg-danger';
                const statusText = sData.status === 'winning' ? 'Currently Winning!' : 'Currently Losing';
                contentDiv.innerHTML = `
                    <h6 class="text-muted mb-1">Tomorrow's Bid</h6>
                    <h3 class="fw-bold mb-2">£${sData.your_bid}</h3>
                    <span class="badge ${badgeColor} px-3 py-2 mb-3" style="font-size: 0.9rem;">${statusText}</span>
                `;
            } else {
                contentDiv.innerHTML = `
                    <h6 class="text-muted mb-1">Tomorrow's Bid</h6>
                    <h3 class="fw-bold mb-2">£${tData.amount}</h3>
                    <span class="badge bg-secondary px-3 py-2 mb-3" style="font-size: 0.9rem;">Status Unknown</span>
                `;
            }
        } else {
            contentDiv.innerHTML = `<div class="py-2"><i class="bi bi-calendar-event fs-2 text-muted d-block mb-2"></i><p class="text-muted mb-0 small">No bid placed for tomorrow.</p></div>`;
        }
    } catch (e) {
        console.error("Bid status error:", e);
        contentDiv.innerHTML = `<p class="text-danger small">Could not load bid status.</p>`;
    } finally {
        loadingDiv.classList.add('d-none');
        contentDiv.classList.remove('d-none');
    }
}

function setupSponsorshipModal(data) {
    const select = document.getElementById('sponsorItemSelect');
    if (!select) return;

    select.innerHTML = '<option value="" selected disabled>Choose a credential to sponsor...</option>';
    
    // Add Certifications
    if (data.Certifications && data.Certifications.length > 0) {
        const optGroup = document.createElement('optgroup');
        optGroup.label = 'Certifications';
        data.Certifications.forEach(c => {
            const opt = document.createElement('option');
            opt.value = `cert_${c.id}`;
            opt.textContent = c.title;
            optGroup.appendChild(opt);
        });
        select.appendChild(optGroup);
    }

    // Add Licences
    if (data.Licences && data.Licences.length > 0) {
        const optGroup = document.createElement('optgroup');
        optGroup.label = 'Licences';
        data.Licences.forEach(l => {
            const opt = document.createElement('option');
            opt.value = `lic_${l.id}`;
            opt.textContent = l.title;
            optGroup.appendChild(opt);
        });
        select.appendChild(optGroup);
    }

    if (select.options.length <= 1) {
        select.innerHTML = '<option value="" disabled>No credentials available to sponsor.</option>';
        document.getElementById('sendOfferBtn').disabled = true;
    }
}

async function handleSendOffer() {
    // Debug check
    console.log("handleSendOffer called");
    
    const itemValue = document.getElementById('sponsorItemSelect').value;
    const amount = document.getElementById('sponsorAmount').value;
    const message = document.getElementById('sponsorMessage').value;
    const btn = document.getElementById('sendOfferBtn');

    if (!itemValue || !amount) {
        alert('Please select an item and enter an amount.');
        return;
    }

    const type = itemValue.startsWith('cert_') ? 'certification' : 'licence';
    const itemId = itemValue.split('_')[1];

    try {
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Sending...';

        const csrfToken = await getCsrfToken();
        const res = await fetch('/api/sponsorship/offer', {
            method: 'POST',
            headers: { 
                'Content-Type': 'application/json',
                'X-CSRF-TOKEN': csrfToken
            },
            body: JSON.stringify({
                ProfileId: currentProfileData.id,
                offer_amount: amount,
                message,
                CertificationId: type === 'certification' ? itemId : null,
                LicenceId: type === 'licence' ? itemId : null
            }),
            credentials: 'include'
        });

        const result = await res.json();
        if (res.ok) {
            alert('Sponsorship offer sent successfully!');
            const modal = bootstrap.Modal.getInstance(document.getElementById('sponsorshipModal'));
            if (modal) modal.hide();
            document.getElementById('sponsorAmount').value = '';
            document.getElementById('sponsorMessage').value = '';
        } else {
            alert('Error: ' + result.error);
        }
    } catch (e) {
        console.error(e);
        alert('Something went wrong.');
    } finally {
        btn.disabled = false;
        btn.innerHTML = 'Send Offer';
    }
}
</script>

<!-- Sponsorship Modal -->
<div class="modal fade" id="sponsorshipModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-primary text-white border-0">
                <h5 class="modal-title fw-bold"><i class="bi bi-award me-2"></i> Make a Sponsorship Offer</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <p class="text-muted small mb-4">Sponsor a specific certification or licence for this alumni. If they accept, the funds will be added to their bidding balance.</p>
                
                <div class="mb-3">
                    <label class="form-label small fw-bold">Select Credential</label>
                    <select id="sponsorItemSelect" class="form-select">
                        <!-- Injected -->
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-bold">Offer Amount (£)</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white">£</span>
                        <input type="number" id="sponsorAmount" class="form-control" placeholder="e.g. 500" min="1">
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-bold">Message (Optional)</label>
                    <textarea id="sponsorMessage" class="form-control" rows="3" placeholder="Tell the alumni why you want to sponsor them..."></textarea>
                </div>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                <button type="button" id="sendOfferBtn" class="btn btn-accent px-4">Send Offer</button>
            </div>
        </div>
    </div>
</div>
