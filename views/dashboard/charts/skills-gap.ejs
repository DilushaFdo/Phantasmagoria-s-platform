<meta name="api-key" content="<%= process.env.ANALYTICS_API_KEY %>">

<div class="container-fluid">
    <div class="row flex-nowrap">
        <%- include('../../partials/dashboardSidebar', { currentPage: 'skills' }) %>
        
        <div class="col py-4 px-4 bg-light min-vh-100 dashboard-main">
            <h2 class="fw-bold mb-4">Skills Gap Analysis</h2>

            <%- include('../../partials/analyticsFilters') %>

            <div id="chartsContainer">
                <div class="row g-4">
                    <!-- A) Radar Chart -->
                    <div class="col-lg-7">
                        <div class="card border-0 shadow-sm h-100">
                            <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center">
                                <h6 class="fw-bold mb-0">Certs vs Courses Density</h6>
                                <button class="btn btn-sm btn-link text-decoration-none btn-download-chart" data-chart="radarChart" data-filename="skills_radar.png">
                                    <i class="bi bi-download"></i> PNG
                                </button>
                            </div>
                            <div class="card-body p-4">
                                <div style="height: 400px;">
                                    <canvas id="radarChart"></canvas>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Stats Panel -->
                    <div class="col-lg-5">
                        <div class="card border-0 shadow-sm mb-4 bg-primary text-white">
                            <div class="card-body p-4 text-center">
                                <i class="bi bi-exclamation-triangle fs-1 mb-2"></i>
                                <h6 class="text-uppercase small fw-bold opacity-75">Most Critical Gap</h6>
                                <h3 class="fw-bold mb-0" id="statCriticalGap">Loading...</h3>
                                <p class="small mb-0 mt-2" id="statAffected">-- alumni affected</p>
                            </div>
                        </div>
                        <div class="card border-0 shadow-sm">
                            <div class="card-body p-4">
                                <h6 class="fw-bold small text-muted text-uppercase mb-3">Fastest Growing Skill</h6>
                                <div class="d-flex align-items-center">
                                    <div class="bg-success bg-opacity-10 p-3 rounded me-3 text-success">
                                        <i class="bi bi-graph-up-arrow fs-3"></i>
                                    </div>
                                    <div>
                                        <h4 class="fw-bold mb-0" id="statFastestGrow">--</h4>
                                        <small class="text-muted">Highest acquisition trend</small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- B) Horizontal Bar Chart -->
                    <div class="col-lg-12">
                        <div class="card border-0 shadow-sm">
                            <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center">
                                <h6 class="fw-bold mb-0">Top 10 Certifications (Popularity Analysis)</h6>
                                <button class="btn btn-sm btn-link text-decoration-none btn-download-chart" data-chart="gapBarChart" data-filename="cert_popularity.png">
                                    <i class="bi bi-download"></i> PNG
                                </button>
                            </div>
                            <div class="card-body p-4">
                                <div class="d-flex justify-content-center gap-4 mb-3">
                                    <small><span class="badge bg-danger">●</span> Critical (>60%)</small>
                                    <small><span class="badge bg-warning text-dark">●</span> Significant (30-60%)</small>
                                    <small><span class="badge bg-success">●</span> Emerging (<30%)</small>
                                </div>
                                <div style="height: 500px;">
                                    <canvas id="gapBarChart"></canvas>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="/js/charts.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', () => {
        initFilters(loadData);
        loadData({});

        // Handle downloads without inline onclick (CSP compliance)
        document.querySelectorAll('.btn-download-chart').forEach(btn => {
            btn.addEventListener('click', () => {
                const chartId = btn.dataset.chart;
                const filename = btn.dataset.filename;
                downloadChart(chartId, filename);
            });
        });
    });

    async function loadData(filters) {
        const loading = document.getElementById('loadingOverlay');
        const content = document.getElementById('chartsContainer');
        loading.classList.remove('d-none');
        content.classList.add('opacity-50');

        try {
            const query = new URLSearchParams(filters).toString();
            const [certRes, courseRes, overviewRes] = await Promise.all([
                fetch(`/api/analytics/certifications?${query}`, { headers: getAuthHeaders(), credentials: 'include' }),
                fetch(`/api/analytics/courses?${query}`, { headers: getAuthHeaders(), credentials: 'include' }),
                fetch(`/api/analytics/overview`, { headers: getAuthHeaders(), credentials: 'include' })
            ]);

            const certJson = await certRes.json();
            const courseJson = await courseRes.json();
            const overviewJson = await overviewRes.json();

            const certData = certJson.data || certJson;
            const courseData = courseJson.data || courseJson;
            const overview = overviewJson.data || overviewJson;

            const certs = certData.mostPopular || [];
            const courses = courseData.mostPopular || [];

            // Draw Charts
            drawRadarChart('radarChart', certs, courses);
            drawGapAnalysisChart('gapBarChart', certs, overview.totalAlumni || 1);

            // Update Stats
            const topGap = certs[0];
            document.getElementById('statCriticalGap').textContent = topGap?.title || 'None';
            document.getElementById('statAffected').textContent = `${topGap?.count || 0} alumni affected`;
            
            const fastest = certs[1]?.title || 'None';
            document.getElementById('statFastestGrow').textContent = fastest;

        } catch (err) {
            console.error(err);
        } finally {
            loading.classList.add('d-none');
            content.classList.remove('opacity-50');
        }
    }
</script>
