<meta name="api-key" content="<%= process.env.ANALYTICS_API_KEY %>">

<div class="container-fluid">
    <div class="row flex-nowrap">
        <%- include('../../partials/dashboardSidebar', { currentPage: 'job-titles' }) %>
        
        <div class="col py-4 px-4 bg-light min-vh-100 dashboard-main">
            <h2 class="fw-bold mb-4">Job Title Insights</h2>

            <%- include('../../partials/analyticsFilters') %>

            <div id="chartsContainer">
                <div class="row g-4">
                    <!-- A) Horizontal Bar Chart -->
                    <div class="col-lg-12">
                        <div class="card border-0 shadow-sm mb-4">
                            <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center">
                                <h6 class="fw-bold mb-0">Market Dominance by Role</h6>
                                <button class="btn btn-sm btn-link text-decoration-none" onclick="downloadChart('rolesBarChart', 'job_roles.png')">
                                    <i class="bi bi-download"></i> PNG
                                </button>
                            </div>
                            <div class="card-body p-4">
                                <div style="height: 400px;">
                                    <canvas id="rolesBarChart"></canvas>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- B) Grouped Bar Chart -->
                    <div class="col-lg-8">
                        <div class="card border-0 shadow-sm h-100">
                            <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center">
                                <h6 class="fw-bold mb-0">Role Comparison Across Degree Programmes</h6>
                                <button class="btn btn-sm btn-link text-decoration-none" onclick="downloadChart('groupedBarChart', 'role_comparison.png')">
                                    <i class="bi bi-download"></i> PNG
                                </button>
                            </div>
                            <div class="card-body p-4">
                                <div style="height: 400px;">
                                    <canvas id="groupedBarChart"></canvas>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Stats Panel -->
                    <div class="col-lg-4">
                        <div class="card border-0 shadow-sm mb-4 bg-dark text-white">
                            <div class="card-body p-4">
                                <h3 class="fw-bold mb-0" id="statTopRoleValue">--</h3>
                                <p class="text-white-50 small mb-0">Top job title identified</p>
                            </div>
                        </div>
                        <div class="card border-0 shadow-sm">
                            <div class="card-body p-4">
                                <h6 class="fw-bold small text-muted text-uppercase mb-3">Most Diverse Programme</h6>
                                <div class="d-flex align-items-center">
                                    <div class="bg-info bg-opacity-10 p-3 rounded me-3 text-info">
                                        <i class="bi bi-shuffle fs-3"></i>
                                    </div>
                                    <div>
                                        <h5 class="fw-bold mb-0" id="statDiverseProg">BSc Computer Science</h5>
                                        <small class="text-muted">Most varied career paths</small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="/js/charts.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', () => {
        initFilters(loadData);
        loadData({});
    });

    async function loadData(filters) {
        const loading = document.getElementById('loadingOverlay');
        const content = document.getElementById('chartsContainer');
        loading.classList.remove('d-none');
        content.classList.add('opacity-50');

        try {
            const query = new URLSearchParams(filters).toString();
            const [empRes, alumniRes] = await Promise.all([
                fetch(`/api/analytics/employment?${query}`, { headers: getAuthHeaders() }),
                fetch(`/api/analytics/alumni?limit=100`, { headers: getAuthHeaders() })
            ]);

            const empData = await empRes.json();
            const alumniData = await alumniRes.json();

            drawJobTitlesChart('rolesBarChart', empData.topRoles);
            drawRolesByProgrammeChart('groupedBarChart', alumniData.alumni);

            document.getElementById('statTopRoleValue').textContent = empData.topRoles[0]?.job_title || 'None';

        } catch (err) {
            console.error(err);
        } finally {
            loading.classList.add('d-none');
            content.classList.remove('opacity-50');
        }
    }
</script>
