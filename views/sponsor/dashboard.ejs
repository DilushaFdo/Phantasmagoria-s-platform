<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Sponsor Dashboard</h2>
    <a href="/dashboard/alumni" class="btn btn-primary fw-bold">
        <i class="bi bi-search me-1"></i> Browse Alumni
    </a>
</div>

<!-- Stats Row -->
<div class="row mb-4" id="statsContainer">
    <div class="col-md-3">
        <div class="card shadow-sm border-0 bg-primary text-white h-100">
            <div class="card-body">
                <h6 class="card-title text-white-50">Total Offers Made</h6>
                <h2 class="mb-0 fw-bold" id="totalOffers">-</h2>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm border-0 bg-success text-white h-100">
            <div class="card-body">
                <h6 class="card-title text-white-50">Accepted Offers</h6>
                <h2 class="mb-0 fw-bold" id="acceptedOffers">-</h2>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm border-0 bg-danger text-white h-100">
            <div class="card-body">
                <h6 class="card-title text-white-50">Rejected Offers</h6>
                <h2 class="mb-0 fw-bold" id="rejectedOffers">-</h2>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm border-0 bg-dark text-white h-100">
            <div class="card-body">
                <h6 class="card-title text-white-50">Total Amount Committed</h6>
                <h2 class="mb-0 fw-bold" id="totalCommitted">£0.00</h2>
            </div>
        </div>
    </div>
</div>

<!-- Recent Offers Table -->
<div class="card shadow-sm border-0">
    <div class="card-header bg-white py-3">
        <h5 class="mb-0 fw-bold">Recent Offers</h5>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Alumni</th>
                        <th>Certification / Licence</th>
                        <th>Amount</th>
                        <th>Status</th>
                        <th>Date</th>
                    </tr>
                </thead>
                <tbody id="offersTableBody">
                    <tr>
                        <td colspan="5" class="text-center py-4 text-muted">
                            <div class="spinner-border spinner-border-sm me-2" role="status"></div> Loading offers...
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', async () => {
    try {
        const res = await fetch('/api/sponsor/dashboard-data');
        if (!res.ok) throw new Error('Failed to fetch dashboard data');
        
        const data = await res.json();
        
        // Update Stats
        document.getElementById('totalOffers').textContent = data.stats.totalOffers || 0;
        document.getElementById('acceptedOffers').textContent = data.stats.acceptedOffers || 0;
        document.getElementById('rejectedOffers').textContent = data.stats.rejectedOffers || 0;
        document.getElementById('totalCommitted').textContent = '£' + parseFloat(data.stats.totalCommitted || 0).toLocaleString('en-GB', { minimumFractionDigits: 2 });
        
        // Populate Table
        const tbody = document.getElementById('offersTableBody');
        tbody.innerHTML = '';
        
        if (!data.recentOffers || data.recentOffers.length === 0) {
            tbody.innerHTML = `<tr><td colspan="5" class="text-center py-4 text-muted">No recent offers found.</td></tr>`;
            return;
        }
        
        data.recentOffers.forEach(offer => {
            let statusBadge = '';
            if (offer.status === 'accepted') statusBadge = '<span class="badge bg-success">Accepted</span>';
            else if (offer.status === 'rejected') statusBadge = '<span class="badge bg-danger">Rejected</span>';
            else statusBadge = '<span class="badge bg-warning text-dark">Pending</span>';
            
            const tr = document.createElement('tr');
            tr.innerHTML = `
                <td class="ps-4 fw-medium">${offer.alumniName || 'Unknown'}</td>
                <td>${offer.credentialName || 'N/A'}</td>
                <td class="fw-bold">£${parseFloat(offer.offer_amount).toLocaleString('en-GB')}</td>
                <td>${statusBadge}</td>
                <td class="text-muted small">${new Date(offer.created_at).toLocaleDateString()}</td>
            `;
            tbody.appendChild(tr);
        });
        
    } catch (err) {
        console.error(err);
        document.getElementById('offersTableBody').innerHTML = `
            <tr><td colspan="5" class="text-center py-4 text-danger"><i class="bi bi-exclamation-circle"></i> Error loading dashboard data.</td></tr>
        `;
    }
});
</script>
