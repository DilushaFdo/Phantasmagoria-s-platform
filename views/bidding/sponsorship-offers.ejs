<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-0" style="color: var(--primary);">Sponsorship Offers</h2>
        <p class="text-muted">Manage your funding and view historical sponsorship data</p>
    </div>
    <a href="/bidding" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i> Back to Bidding
    </a>
</div>

<!-- SECTION 1: Wallet Balance Card -->
<div class="row mb-4">
    <div class="col-12">
        <div class="card border-0 shadow-sm overflow-hidden" style="background: linear-gradient(135deg, var(--primary) 0%, #2a3d66 100%);">
            <div class="card-body p-4 text-white text-center">
                <p class="text-white text-opacity-75 mb-2 fw-medium">Available Bid Balance</p>
                <h1 class="display-3 fw-bold mb-2" id="wallet-balance" data-amount="0.00">£0.00</h1>
                <p class="small mb-0 text-white text-opacity-75">
                    <i class="bi bi-info-circle me-1"></i> Funded by your accepted sponsorships
                </p>
            </div>
        </div>
    </div>
</div>

<!-- SECTION 2: Pending Offers -->
<div class="mb-5">
    <h5 class="fw-bold mb-3 d-flex align-items-center">
        <i class="bi bi-clock-history me-2 text-primary"></i> Pending Offers
        <span class="badge bg-danger ms-2 d-none" id="pendingCountBadge">0</span>
    </h5>
    
    <!-- Loading Spinner -->
    <div class="col-12 text-center py-5" id="pendingLoading">
        <div class="spinner-border text-primary" role="status"></div>
        <p class="mt-2 text-muted">Fetching your offers...</p>
    </div>

    <div id="pendingOffersGrid" class="row"></div>
    
    <!-- Empty State -->
    <div id="noPendingState" class="card border-0 shadow-sm d-none">
        <div class="card-body text-center py-5">
            <div class="mb-3 text-muted opacity-50">
                <i class="bi bi-mailbox" style="font-size: 3rem;"></i>
            </div>
            <h5 class="fw-bold">No pending offers right now</h5>
            <p class="text-muted mb-0 mx-auto" style="max-width: 400px;">
                Sponsors can find you through the alumni directory and make offers on your certifications and licences.
            </p>
        </div>
    </div>
</div>

<!-- SECTION 3: Accepted Offers -->
<div class="accordion mb-3 shadow-sm border-0" id="acceptedOffersAccordion">
    <div class="accordion-item border-0 rounded">
        <h2 class="accordion-header">
            <button class="accordion-button collapsed fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#collapseAccepted">
                <i class="bi bi-check-circle-fill text-success me-2"></i> Accepted Offers (<span id="acceptedCount">0</span>)
            </button>
        </h2>
        <div id="collapseAccepted" class="accordion-collapse collapse" data-bs-parent="#acceptedOffersAccordion">
            <div class="accordion-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0 align-middle">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Company</th>
                                <th>For</th>
                                <th>Amount</th>
                                <th class="pe-4 text-end">Date Accepted</th>
                            </tr>
                        </thead>
                        <tbody id="acceptedTableBody">
                            <!-- Rows injected by JS -->
                        </tbody>
                    </table>
                </div>
                <div id="emptyAcceptedState" class="text-center p-4 text-muted d-none">
                    No accepted offers yet.
                </div>
            </div>
        </div>
    </div>
</div>

<!-- SECTION 4: Rejected Offers -->
<div class="accordion shadow-sm border-0" id="rejectedOffersAccordion">
    <div class="accordion-item border-0 rounded">
        <h2 class="accordion-header">
            <button class="accordion-button collapsed fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#collapseRejected">
                <i class="bi bi-x-circle-fill text-danger me-2"></i> Rejected Offers (<span id="rejectedCount">0</span>)
            </button>
        </h2>
        <div id="collapseRejected" class="accordion-collapse collapse" data-bs-parent="#rejectedOffersAccordion">
            <div class="accordion-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0 align-middle">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Company</th>
                                <th>For</th>
                                <th>Amount</th>
                                <th class="pe-4 text-end">Date Responded</th>
                            </tr>
                        </thead>
                        <tbody id="rejectedTableBody">
                            <!-- Rows injected by JS -->
                        </tbody>
                    </table>
                </div>
                <div id="emptyRejectedState" class="text-center p-4 text-muted d-none">
                    No rejected offers.
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Toast Container -->
<div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1100">
  <div id="liveToast" class="toast align-items-center text-white bg-success border-0" role="alert" aria-live="assertive" aria-atomic="true">
    <div class="d-flex">
      <div class="toast-body" id="toastMsg">Success!</div>
      <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
    </div>
  </div>
</div>

<script>
let globalCsrf = '';
let currentWalletBalance = 0;

document.addEventListener('DOMContentLoaded', async () => {
    try {
        const csrfToken = await getCsrfToken();
        globalCsrf = csrfToken;

        await Promise.all([
            loadWalletBalance(),
            loadOffers()
        ]);

        // --- EVENT DELEGATION FOR SPONSORSHIP OFFERS ---
        const grid = document.getElementById('pendingOffersGrid');
        if (grid) {
            grid.addEventListener('click', function(e) {
                const respondBtn = e.target.closest('.btn-respond-offer');
                if (respondBtn) {
                    const id = respondBtn.dataset.id;
                    const action = respondBtn.dataset.action;
                    const amount = respondBtn.dataset.amount;
                    handleRespond(id, action, amount, respondBtn);
                }
            });
        }
    } catch (err) {
        console.error(err);
        showToast("Failed to initialize page data.", "danger");
    }
});

async function apiCall(url, method, bodyObj) {
    try {
        const csrfToken = await getCsrfToken();
        const res = await fetch(url, {
            method: method,
            headers: {
                'Content-Type': 'application/json',
                'X-CSRF-TOKEN': csrfToken
            },
            credentials: 'include',
            body: bodyObj ? JSON.stringify(bodyObj) : undefined
        });
        const json = await res.json();
        const data = json.data || json;
        if(!res.ok) throw new Error(data.error || data.message || 'API Error');
        return data;
    } catch (error) {
        throw error;
    }
}

async function loadWalletBalance() {
    try {
        const res = await fetch('/api/profile', { credentials: 'include' });
        if (!res.ok) throw new Error('Failed to load profile');
        const json = await res.json();
        const data = json.data || json;
        currentWalletBalance = parseFloat(data.wallet_balance) || 0;
        const walletEl = document.getElementById('wallet-balance');
        walletEl.textContent = `£${currentWalletBalance.toFixed(2)}`;
        walletEl.dataset.amount = currentWalletBalance.toString();
    } catch (err) {
        console.error(err);
    }
}

async function loadOffers() {
    const grid = document.getElementById('pendingOffersGrid');
    const loading = document.getElementById('pendingLoading');
    const noPending = document.getElementById('noPendingState');
    const badge = document.getElementById('pendingCountBadge');

    if (!grid || !loading) return; // Defensive check

    try {
        loading.classList.remove('d-none');
        grid.innerHTML = '';
        if (noPending) noPending.classList.add('d-none');

        const res = await fetch('/api/sponsorship/my-offers', { credentials: 'include' });
        if (!res.ok) throw new Error('Failed to fetch offers');
        const json = await res.json();
        const data = json.data || json;
        const offers = data.offers || { pending: [], accepted: [], rejected: [] };

        // Pending
        const pending = offers.pending || [];
        loading.classList.add('d-none');
        grid.innerHTML = '';
        
        if (pending.length === 0) {
            noPending.classList.remove('d-none');
            badge.classList.add('d-none');
        } else {
            noPending.classList.add('d-none');
            badge.textContent = pending.length;
            badge.classList.remove('d-none');
            
            pending.forEach(o => {
                const title = o.Certification ? o.Certification.title : (o.Licence ? o.Licence.title : 'Unknown Credential');
                const type = o.Certification ? 'Certification' : 'Licence';
                
                const col = document.createElement('div');
                col.className = 'col-md-6 mb-4';
                col.innerHTML = `
                    <div class="card h-100 border-0 shadow-sm">
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between mb-3">
                                <div>
                                    <h5 class="fw-bold mb-1">${o.Sponsor?.company_name || 'Anonymous Sponsor'}</h5>
                                    <span class="badge bg-light text-primary border border-primary border-opacity-25">${type}</span>
                                </div>
                                <div class="text-end">
                                    <div class="display-6 fw-bold text-success" style="font-size: 1.5rem;">£${parseFloat(o.offer_amount).toFixed(2)}</div>
                                </div>
                            </div>
                            <div class="mb-4">
                                <small class="text-muted d-block mb-1">Message from sponsor:</small>
                                <p class="mb-0 fst-italic">"${o.message || 'No message provided.'}"</p>
                            </div>
                            <div class="alert alert-light border py-2 mb-4">
                                <small class="text-muted fw-bold">For your ${type.toLowerCase()}:</small>
                                <div class="small fw-bold text-truncate">${title}</div>
                            </div>
                            <div class="row g-2">
                                <div class="col-6">
                                    <button class="btn btn-success w-100 fw-bold py-2 btn-respond-offer" data-id="${o.id}" data-action="accept" data-amount="${o.offer_amount}">
                                        <i class="bi bi-check-circle me-1"></i> Accept
                                    </button>
                                </div>
                                <div class="col-6">
                                    <button class="btn btn-outline-danger w-100 fw-bold py-2 btn-respond-offer" data-id="${o.id}" data-action="reject" data-amount="0">
                                        <i class="bi bi-x-circle me-1"></i> Decline
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                `;
                grid.appendChild(col);
            });
        }

        // Accepted
        const accepted = offers.accepted || [];
        renderHistoryTable('accepted', accepted);

        // Rejected
        const rejected = offers.rejected || [];
        renderHistoryTable('rejected', rejected);

    } catch (err) {
        console.error(err);
        loading.innerHTML = `<div class="alert alert-danger">Error loading offers.</div>`;
    }
}

function renderHistoryTable(status, list) {
    const countSpan = document.getElementById(`${status}Count`);
    const tbody = document.getElementById(`${status}TableBody`);
    const emptyState = document.getElementById(`empty${status.charAt(0).toUpperCase() + status.slice(1)}State`);
    
    countSpan.textContent = list.length;
    tbody.innerHTML = '';
    
    if (list.length === 0) {
        emptyState.classList.remove('d-none');
        return;
    }
    
    emptyState.classList.add('d-none');
    
    list.forEach(o => {
        const title = o.Certification ? o.Certification.title : (o.Licence ? o.Licence.title : 'Unknown');
        const date = o.responded_at ? new Date(o.responded_at).toLocaleDateString() : 'N/A';
        const badgeClass = status === 'accepted' ? 'bg-success' : 'bg-danger';
        
        const tr = document.createElement('tr');
        tr.innerHTML = `
            <td class="ps-4">
                <div class="fw-bold">${o.Sponsor?.company_name || 'Sponsor'}</div>
            </td>
            <td>
                <div class="small text-muted text-truncate" style="max-width: 200px;" title="${title}">${title}</div>
            </td>
            <td>
                <span class="badge ${badgeClass} bg-opacity-10 text-${status === 'accepted' ? 'success' : 'danger'} border border-${status === 'accepted' ? 'success' : 'danger'} border-opacity-25">
                    £${parseFloat(o.offer_amount).toFixed(2)}
                </span>
            </td>
            <td class="pe-4 text-end small text-muted">${date}</td>
        `;
        tbody.appendChild(tr);
    });
}

async function handleRespond(id, action, amount, btn) {
    let originalHtml = '';
    if (btn) {
        originalHtml = btn.innerHTML;
        btn.innerHTML = `<span class="spinner-border spinner-border-sm me-1"></span> Processing...`;
        // Disable sibling buttons too
        const parent = btn.closest('.row');
        if (parent) {
            parent.querySelectorAll('button').forEach(b => b.disabled = true);
        }
    }

    try {
        const data = await apiCall(`/api/sponsorship/respond/${id}`, 'POST', { action });
        
        if (action === 'accept') {
            showToast(`Offer accepted! £${parseFloat(amount).toFixed(2)} added to your wallet.`, 'success');
            
            const walletEl = document.getElementById('wallet-balance');
            const currentBalance = parseFloat(walletEl.dataset.amount || 0);
            const offerAmount = parseFloat(amount);
            const newBalance = currentBalance + offerAmount

            walletEl.textContent = '£' + newBalance.toFixed(2);
            walletEl.dataset.amount = newBalance.toString();

            // Also update the bidding page max bid display if visible
            const maxBidDisplay = document.getElementById('max-bid-amount');
            if (maxBidDisplay) {
                maxBidDisplay.textContent = '£' + newBalance.toFixed(2);
            }
        } else {
            showToast('Offer declined.', 'warning');
        }
        
        // Refresh the list
        await loadOffers();
        
    } catch (err) {
        showToast(err.message, 'danger');
        if (btn) {
            btn.innerHTML = originalHtml;
            const parent = btn.closest('.row');
            if (parent) {
                parent.querySelectorAll('button').forEach(b => b.disabled = false);
            }
        }
    }
}
window.handleRespond = handleRespond;
</script>
