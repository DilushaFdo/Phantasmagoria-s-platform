<script>
let globalCsrf = '';
let currentBidAmount = 0;
let tomorrowStr = '';
let totalAvailableSponsorship = 0;

// Pagination State
let allBids = [];
let currentPage = 1;
const itemsPerPage = 10;
let toastInstance = null;

document.addEventListener('DOMContentLoaded', async () => {
    // Calculate Tomorrow's Date
    const tmrw = new Date();
    tmrw.setDate(tmrw.getDate() + 1);
    tomorrowStr = tmrw.toISOString().split('T')[0];
    
    const displayOptions = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
    document.getElementById('tomorrowDateDisplay').textContent = tmrw.toLocaleDateString('en-GB', displayOptions);
    
    // Set default and min for date picker
    const dateInput = document.getElementById('bidTargetDate');
    if (dateInput) {
        dateInput.min = tomorrowStr;
        dateInput.value = tomorrowStr;
    }

    try {
        const csrfToken = await getCsrfToken();
        globalCsrf = csrfToken;

        await Promise.all([
            loadSponsorships(),
            loadTomorrowBid(),
            loadMonthlyLimit(),
            loadHistory()
        ]);

        document.getElementById('biddingSkeleton').classList.add('d-none');
        document.getElementById('biddingContent').classList.remove('d-none');
        document.getElementById('historyContent').classList.remove('d-none');
        
    } catch (err) {
        handleFetchError(err);
        document.getElementById('biddingSkeleton').innerHTML = '<div class="alert alert-danger w-100 text-center">Failed to load bidding data. Please refresh.</div>';
    }

    // Attach Listeners
    document.getElementById('formPlaceBid').addEventListener('submit', handlePlaceBid);
    
    document.getElementById('placeBidAmount').addEventListener('input', (e) => {
        const amt = parseFloat(e.target.value) || 0;
        const errDiv = document.getElementById('bidAmountError');
        const earnDiv = document.getElementById('potentialEarnings');
        const btn = document.getElementById('btnPlaceBid');

        if (amt > totalAvailableSponsorship) {
            errDiv.textContent = `Bid cannot exceed your wallet balance of £${totalAvailableSponsorship.toFixed(2)}`;
            errDiv.classList.remove('d-none');
            earnDiv.textContent = '';
            btn.disabled = true;
        } else {
            errDiv.classList.add('d-none');
            const earnings = Math.max(0, totalAvailableSponsorship - amt);
            earnDiv.textContent = `If you win: you keep £${earnings.toFixed(2)}`;
            btn.disabled = false;
        }
    });

    document.getElementById('formIncreaseBid').addEventListener('submit', handleIncreaseBid);
    document.getElementById('btnCancelBid').addEventListener('click', handleCancelBid);
    
    document.getElementById('btnToggleIncrease').addEventListener('click', () => {
        document.getElementById('formIncreaseBid').classList.remove('d-none');
        document.getElementById('newBidAmount').min = (currentBidAmount + 0.01).toFixed(2);
        document.getElementById('newBidAmount').value = (currentBidAmount + 1.00).toFixed(2);
    });
    document.getElementById('btnCancelIncrease').addEventListener('click', () => {
        document.getElementById('formIncreaseBid').classList.add('d-none');
    });

    document.getElementById('btnPrevPage').addEventListener('click', () => changePage(-1));
    document.getElementById('btnNextPage').addEventListener('click', () => changePage(1));

    // --- EVENT DELEGATION FOR SPONSORSHIP OFFERS ---
    const pendingOffersContainer = document.getElementById('pendingOffersContainer');
    if (pendingOffersContainer) {
        pendingOffersContainer.addEventListener('click', function(e) {
            const respondBtn = e.target.closest('.btn-respond-offer');
            if (respondBtn) {
            const id = respondBtn.dataset.id;
            const action = respondBtn.dataset.action;
            const amount = respondBtn.dataset.amount;
            respondToOffer(id, action, amount);
            }
        });
    }
});

async function apiCall(url, method, bodyObj, btnId) {
    const btn = btnId ? document.getElementById(btnId) : null;
    if(btn) setBtnLoading(btn, true);
    
    try {
        const csrfToken = await getCsrfToken();
        const res = await fetch(url, {
            method: method,
            headers: {
                'Content-Type': 'application/json',
                'X-CSRF-TOKEN': csrfToken
            },
            credentials: 'include',
            body: bodyObj ? JSON.stringify(bodyObj) : undefined
        });
        const json = await res.json();
        const data = json.data || json;
        if(!res.ok) throw new Error(data.error || data.message || 'API Error');
        return data;
    } finally {
        if(btn) setBtnLoading(btn, false);
    }
}

// ── Loaders ──
async function loadSponsorships() {
    try {
        const [sumRes, offRes, profRes] = await Promise.all([
            fetch('/api/sponsorship/summary', { credentials: 'include' }),
            fetch('/api/sponsorship/my-offers', { credentials: 'include' }),
            fetch('/api/profile', { credentials: 'include' })
        ]);
        
        const parseJson = async (res) => {
            if (!res.ok) {
                const text = await res.text();
                let errorData = {};
                try { errorData = JSON.parse(text); } catch(e) {}
                throw new Error(errorData.message || errorData.error || `Request failed with status ${res.status}`);
            }
            return await res.json();
        };

        const sumJson = await parseJson(sumRes);
        const offJson = await parseJson(offRes);
        const profJson = await parseJson(profRes);

        const sumData = sumJson.data || sumJson;
        const offData = offJson.data || offJson;
        const profData = profJson.data || profJson;

        // CHANGE 1: Wallet Balance Banner
        const walletAmt = parseFloat(profData.wallet_balance) || 0;
        totalAvailableSponsorship = walletAmt;

        const walletEl = document.getElementById('wallet-balance');
        const walletBanner = document.getElementById('walletBanner');
        const walletStatus = document.getElementById('walletStatusMsg');
        const walletIconBg = document.getElementById('walletIconBg');
        const walletIcon = document.getElementById('walletIcon');

        walletBanner.classList.remove('d-none');
        walletEl.textContent = `£${walletAmt.toFixed(2)}`;
        walletEl.dataset.amount = walletAmt.toString();

        if (walletAmt === 0) {
            walletBanner.classList.add('border-start', 'border-danger', 'border-4');
            walletIconBg.style.backgroundColor = 'rgba(220, 53, 69, 0.1)';
            walletIcon.className = 'bi bi-wallet2 fs-4 text-danger';
            walletStatus.innerHTML = `
                <span class="text-danger fw-bold d-block">You have no funds yet.</span>
                <a href="/sponsorship-offers" class="text-decoration-none small fw-bold text-danger">Check sponsorship offers to accept funding →</a>
            `;
        } else {
            walletBanner.classList.add('border-start', 'border-success', 'border-4');
            walletIconBg.style.backgroundColor = 'rgba(25, 135, 84, 0.1)';
            walletIcon.className = 'bi bi-wallet2 fs-4 text-success';
            walletStatus.innerHTML = `<span class="text-success fw-bold">Your wallet is funded and ready for bidding!</span>`;
        }

        // CHANGE 2: Pending Offers Alert
        const pendingOffers = offData.offers?.pending || [];
        const badge = document.getElementById('pendingOffersBadge');
        const alertBanner = document.getElementById('pendingAlert');
        const alertCount = document.getElementById('pendingAlertCount');

        if (pendingOffers.length > 0) {
            badge.textContent = pendingOffers.length;
            badge.classList.remove('d-none');
            alertCount.textContent = pendingOffers.length;
            alertBanner.classList.remove('d-none');
        } else {
            badge.classList.add('d-none');
            alertBanner.classList.add('d-none');
        }

        // Section summary UI
        const sumContainer = document.getElementById('sponsorshipSummaryContainer');
        if (totalAvailableSponsorship === 0) {
            sumContainer.innerHTML = `
                <div class="card border-warning shadow-sm">
                    <div class="card-body bg-warning bg-opacity-10 text-dark p-4">
                        <h5 class="fw-bold"><i class="bi bi-exclamation-triangle-fill text-warning me-2"></i> No Bidding Funds Available</h5>
                        <p class="mb-0">You need to accept sponsorship offers before you can place bids. Your certifications and licences are visible to potential sponsors in the alumni directory.</p>
                    </div>
                </div>
            `;
            document.getElementById('placeBidAmount').disabled = true;
            document.getElementById('btnPlaceBid').disabled = true;
        } else {
            const listHtml = (sumData.sponsorships || []).map(s => `<li><strong>${s.sponsor}</strong>: £${Number(s.amount).toFixed(2)} for ${s.for}</li>`).join('');
            sumContainer.innerHTML = `
                <div class="card border-primary shadow-sm">
                    <div class="card-body p-4">
                        <h5 class="fw-bold text-primary"><i class="bi bi-wallet2 me-2"></i> Bidding Balance Breakdown</h5>
                        <h3 class="fw-bold mb-3">Total available: £${totalAvailableSponsorship.toFixed(2)}</h3>
                        <ul class="mb-0 small">${listHtml}</ul>
                    </div>
                </div>
            `;
            document.getElementById('max-bid-amount').textContent = `Maximum bid: £${totalAvailableSponsorship.toFixed(2)}`;
            document.getElementById('placeBidAmount').max = totalAvailableSponsorship;
            document.getElementById('placeBidAmount').disabled = false;
            document.getElementById('btnPlaceBid').disabled = false;
        }

        const pendingContainer = document.getElementById('pendingOffersContainer');
        if (pendingOffers.length > 0) {
            let html = `
                <div class="card shadow-sm border-0 mt-2">
                    <div class="card-header bg-white py-3">
                        <h5 class="mb-0 fw-bold">Review Your Offers</h5>
                    </div>
                    <ul class="list-group list-group-flush">
            `;
            
            pendingOffers.forEach(o => {
                const title = o.Certification ? o.Certification.title : (o.Licence ? o.Licence.title : 'Unknown');
                html += `
                    <li class="list-group-item p-3 d-flex justify-content-between align-items-center flex-wrap gap-3">
                        <div>
                            <div class="fw-bold">${o.Sponsor?.company_name || 'Sponsor'}</div>
                            <div class="small text-muted">Offered for: ${title}</div>
                            <div class="fw-bold text-success mt-1">£${Number(o.offer_amount).toFixed(2)}</div>
                        </div>
                        <div>
                            <button class="btn btn-sm btn-success me-1 px-3 btn-respond-offer" data-id="${o.id}" data-action="accept" data-amount="${o.offer_amount}"><i class="bi bi-check-circle"></i> Accept</button>
                            <button class="btn btn-sm btn-danger px-3 btn-respond-offer" data-id="${o.id}" data-action="reject" data-amount="0"><i class="bi bi-x-circle"></i> Reject</button>
                        </div>
                    </li>
                `;
            });
            html += `</ul></div>`;
            pendingContainer.innerHTML = html;
        } else {
            pendingContainer.innerHTML = '';
        }

        document.getElementById('sponsorshipRow').classList.remove('d-none');
    } catch (err) {
        console.error("Error loading sponsorships:", err);
    }
}

async function respondToOffer(sponsorshipId, action) {
    try {
        const data = await apiCall(`/api/sponsorship/respond/${sponsorshipId}`, 'POST', { action });
        
        if (action === 'accept') {
            const offerAmt = parseFloat(amount || 0);
            showToast(`Offer accepted! £${offerAmt.toFixed(2)} added to your balance.`);
            
            // Immediate UI update
            const walletEl = document.getElementById('wallet-balance');
            const currentBal = parseFloat(walletEl.dataset.amount || 0);
            const newBal = currentBal + offerAmt;
            
            walletEl.textContent = '£' + newBal.toFixed(2);
            walletEl.dataset.amount = newBal.toString();
            
            const maxBidDisplay = document.getElementById('max-bid-amount');
            if (maxBidDisplay) {
                maxBidDisplay.textContent = 'Maximum bid: £' + newBal.toFixed(2);
            }
            
            totalAvailableSponsorship = newBal;
        } else {
            showToast('Offer rejected.');
        }
        
        // Still refresh to sync other UI elements (badge, lists)
        await loadSponsorships();
        await loadTomorrowBid();
    } catch (err) {
        showToast(err.message, "error");
    }
}
window.respondToOffer = respondToOffer;

async function loadTomorrowBid() {
    try {
        const tRes = await fetch('/api/bids/tomorrow', { credentials: 'include' });
        const tJson = await tRes.json();
        const tData = tJson.data || tJson;

        const activeState = document.getElementById('activeBidState');
        const noState = document.getElementById('noBidState');

        if (tData.bid_placed) {
            currentBidAmount = Number(tData.amount);
            document.getElementById('activeBidAmount').textContent = `£${currentBidAmount.toFixed(2)}`;
            
            // Fetch Status
            const sRes = await fetch(`/api/bids/status?target_date=${tomorrowStr}`, { credentials: 'include' });
            const badgeContainer = document.getElementById('activeBidBadgeContainer');
            
            if (sRes.ok) {
                const sJson = await sRes.json();
                const sData = sJson.data || sJson;
                if (sData.status === 'winning') {
                    badgeContainer.innerHTML = `<span class="badge bg-success px-4 py-2" style="font-size: 1rem;"><i class="bi bi-trophy-fill me-1"></i> WINNING</span>`;
                } else {
                    badgeContainer.innerHTML = `<span class="badge bg-danger px-4 py-2" style="font-size: 1rem;"><i class="bi bi-exclamation-circle me-1"></i> NOT WINNING</span>`;
                }
            } else {
                badgeContainer.innerHTML = `<span class="badge bg-secondary px-4 py-2" style="font-size: 1rem;">STATUS PENDING</span>`;
            }

            document.getElementById('formIncreaseBid').classList.add('d-none');
            activeState.classList.remove('d-none');
            noState.classList.add('d-none');
        } else {
            activeState.classList.add('d-none');
            noState.classList.remove('d-none');
        }
    } catch (err) { handleFetchError(err); }
}

async function loadMonthlyLimit() {
    try {
        const res = await fetch('/api/bids/monthly-status', { credentials: 'include' });
        const json = await res.json();
        const data = json.data || json;

        const container = document.getElementById('slotsVisualContainer');
        const textDisplay = document.getElementById('slotsTextDisplay');
        const warning = document.getElementById('limitWarningBanner');
        const bonusNote = document.getElementById('bonusSlotNote');

        const max = data.max_allowed_wins;
        const used = data.monthly_win_count;
        const hasBonus = data.attended_university_event;

        let html = '';
        for(let i=0; i<max; i++) {
            if(i < used) {
                html += `<i class="bi bi-circle-fill fs-2" style="color: var(--primary);"></i>`;
            } else {
                if(i === 3 && hasBonus) {
                    html += `<i class="bi bi-star-fill fs-2" style="color: var(--accent);"></i>`;
                } else {
                    html += `<i class="bi bi-circle fs-2" style="color: var(--primary);"></i>`;
                }
            }
        }
        
        container.innerHTML = html;
        textDisplay.textContent = `${used} of ${max} slots used this month`;
        
        if (hasBonus) {
            bonusNote.innerHTML = `<span style="color: var(--accent);"><i class="bi bi-patch-check-fill me-1"></i> Bonus slot active from university event</span>`;
        }

        if (data.remaining_slots === 0) {
            warning.classList.remove('d-none');
            document.getElementById('btnPlaceBid').disabled = true;
        } else {
            warning.classList.add('d-none');
            document.getElementById('btnPlaceBid').disabled = false;
        }
    } catch (err) { handleFetchError(err); }
}

async function loadHistory() {
    try {
        const res = await fetch('/api/bids/my-bids', { credentials: 'include' });
        const json = await res.json();
        const data = json.data || json;
        allBids = data.bids || [];
        currentPage = 1;
        renderHistoryTable();
    } catch (err) { handleFetchError(err); }
}

// ── Actions ──
async function handlePlaceBid(e) {
    e.preventDefault();
    const amt = parseFloat(document.getElementById('placeBidAmount').value);
    const selectedDate = document.getElementById('bidTargetDate').value;
    
    if (!selectedDate) {
        showToast("Please select a target date.", "error");
        return;
    }

    const target_date = new Date(selectedDate).toISOString();

    try {
        await apiCall('/api/bids/place', 'POST', { target_date, bid_amount: amt }, 'btnPlaceBid');
        showToast('Bid placed successfully!');
        await Promise.all([loadTomorrowBid(), loadHistory()]);
    } catch(err) { handleFetchError(err); }
}

async function handleIncreaseBid(e) {
    e.preventDefault();
    const amt = parseFloat(document.getElementById('newBidAmount').value);
    if(amt <= currentBidAmount) {
        showToast("New amount must be higher than current bid.", "error");
        return;
    }

    const tmrw = new Date();
    tmrw.setDate(tmrw.getDate() + 1);
    tmrw.setUTCHours(0, 0, 0, 0);
    const target_date = tmrw.toISOString();

    try {
        await apiCall('/api/bids/update', 'PUT', { target_date, new_bid_amount: amt }, 'btnSubmitIncrease');
        showToast('Bid increased successfully!');
        await Promise.all([loadTomorrowBid(), loadHistory()]);
    } catch(err) { handleFetchError(err); }
}

async function handleCancelBid() {
    if(!confirm("Are you sure you want to cancel your bid for tomorrow? This cannot be undone.")) return;
    
    try {
        const btn = document.getElementById('btnCancelBid');
        setBtnLoading(btn, true);
        
        const csrfToken = await getCsrfToken();
        const res = await fetch(`/api/bids/delete?target_date=${tomorrowStr}`, {
            method: 'DELETE',
            headers: { 'X-CSRF-TOKEN': csrfToken },
            credentials: 'include'
        });
        const data = await res.json();
        setBtnLoading(btn, false);
        
        if(!res.ok) throw new Error(data.error || data.message || 'API Error');
        
        showToast('Bid cancelled successfully.');
        await Promise.all([loadTomorrowBid(), loadHistory()]);
    } catch(err) { handleFetchError(err); }
}

// ── Pagination ──
function changePage(delta) {
    currentPage += delta;
    renderHistoryTable();
}

function renderHistoryTable() {
    const tbody = document.getElementById('historyTableBody');
    const emptyState = document.getElementById('emptyHistoryState');
    const tableContainer = document.querySelector('.table-responsive');
    
    if (allBids.length === 0) {
        tableContainer.classList.add('d-none');
        emptyState.classList.remove('d-none');
        updatePaginationUI();
        return;
    }
    
    tableContainer.classList.remove('d-none');
    emptyState.classList.add('d-none');
    
    const startIdx = (currentPage - 1) * itemsPerPage;
    const endIdx = startIdx + itemsPerPage;
    const pageData = allBids.slice(startIdx, endIdx);
    
    let html = '';
    pageData.forEach(bid => {
        const dStr = new Date(bid.target_date).toLocaleDateString('en-GB', { year: 'numeric', month: 'short', day: 'numeric' });
        
        let rowClass = '';
        let badgeClass = 'bg-secondary';
        
        if(bid.status === 'won') { rowClass = 'table-success'; badgeClass = 'bg-success'; }
        else if(bid.status === 'lost') { rowClass = 'table-danger'; badgeClass = 'bg-danger'; }
        else if(bid.status === 'pending') { badgeClass = 'bg-warning text-dark'; }
        else if(bid.status === 'cancelled') { rowClass = 'table-secondary text-muted'; }
        
        html += `
            <tr class="${rowClass}">
                <td class="ps-4 fw-bold">${dStr}</td>
                <td>£${Number(bid.bid_amount).toFixed(2)}</td>
                <td><span class="badge ${badgeClass}">${bid.status.toUpperCase()}</span></td>
                <td class="pe-4 text-end">
                    ${bid.status === 'won' ? 'Featured Alumni' : (bid.status === 'lost' ? 'Outbid' : '-')}
                </td>
            </tr>
        `;
    });
    
    tbody.innerHTML = html;
    updatePaginationUI();
}

function updatePaginationUI() {
    const maxPage = Math.ceil(allBids.length / itemsPerPage) || 1;
    document.getElementById('pageIndicator').textContent = `Page ${currentPage} of ${maxPage}`;
    document.getElementById('btnPrevPage').disabled = currentPage <= 1;
    document.getElementById('btnNextPage').disabled = currentPage >= maxPage;
}

// Global helpers (showToast, setBtnLoading, handleFetchError) are provided by main.js

</script>
